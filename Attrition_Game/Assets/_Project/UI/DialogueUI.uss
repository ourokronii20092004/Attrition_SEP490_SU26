/* ═══════════════════════════════════════════════════════
   DialogueUI.uss — Attrition NPC Dialogue System
   Phong cách: Dark RPG, viền vàng kim, hiệu ứng mượt mà.
   ═══════════════════════════════════════════════════════ */

/* ──── GLOBAL ──── */
.hidden {
    display: none;
}

/* ═════════════════════════════════
   DIALOGUE OVERLAY + PANEL
   ═════════════════════════════════ */
.dialogue-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 24px;
}

.dialogue-panel {
    width: 72%;
    max-width: 860px;
    background-color: rgba(8, 6, 18, 0.93);
    border-width: 2px;
    border-color: rgba(200, 170, 80, 0.55);
    border-radius: 12px;
    padding: 20px 28px 16px 28px;

    /* Slide-up animation */
    translate: 0 40px;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.4s, 0.35s;
    transition-timing-function: ease-out, ease-out;
}

.dialogue-panel.visible {
    translate: 0 0;
    opacity: 1;
}

/* ──── SPEAKER ──── */
.speaker-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.speaker-name {
    font-size: 20px;
    color: #E8C869;
    -unity-font-style: bold;
    letter-spacing: 1px;
    text-shadow: 0 0 8px rgba(232, 200, 105, 0.4);
}

/* ──── DIALOGUE TEXT ──── */
.dialogue-text {
    font-size: 16px;
    color: #D8D3C8;
    white-space: normal;
    min-height: 48px;
    margin-bottom: 10px;
    line-height: 140%;
}

/* ──── QUEST INFO ──── */
.quest-info {
    background-color: rgba(200, 170, 80, 0.08);
    border-width: 1px;
    border-color: rgba(200, 170, 80, 0.25);
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 10px;

    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.quest-info.visible {
    opacity: 1;
}

.quest-title {
    font-size: 15px;
    color: #F0D878;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.quest-desc {
    font-size: 13px;
    color: #B0A890;
    white-space: normal;
}

/* ──── BUTTONS ──── */
.dialogue-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.dlg-btn {
    background-color: rgba(200, 170, 80, 0.12);
    border-width: 1px;
    border-color: rgba(200, 170, 80, 0.4);
    border-radius: 6px;
    color: #E8D8A8;
    font-size: 14px;
    -unity-font-style: bold;
    padding: 8px 24px;
    margin: 0 6px;
    cursor: initial;

    /* Hover animation */
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s, 0.2s, 0.2s;
    transition-timing-function: ease-out, ease, ease;
}

.dlg-btn:hover {
    scale: 1.07;
    background-color: rgba(200, 170, 80, 0.25);
    border-color: rgba(232, 200, 105, 0.7);
}

.dlg-btn:active {
    scale: 0.97;
    background-color: rgba(200, 170, 80, 0.35);
}

.btn-accept {
    border-color: rgba(100, 200, 100, 0.5);
    color: #A8E8A0;
}

.btn-accept:hover {
    border-color: rgba(120, 230, 120, 0.7);
    background-color: rgba(100, 200, 100, 0.2);
}

.btn-decline {
    border-color: rgba(200, 100, 100, 0.4);
    color: #E8A8A0;
}

.btn-decline:hover {
    border-color: rgba(230, 120, 120, 0.6);
    background-color: rgba(200, 100, 100, 0.15);
}

/* ──── KEY HINT ──── */
.key-hint {
    font-size: 11px;
    color: rgba(180, 170, 150, 0.5);
    -unity-text-align: middle-center;
    margin-top: 6px;
}

/* ═════════════════════════════════
   REWARD POPUP
   ═════════════════════════════════ */
.reward-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    justify-content: center;
    align-items: center;

    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.reward-overlay.visible {
    opacity: 1;
}

.reward-panel {
    width: 380px;
    background-color: rgba(12, 10, 24, 0.96);
    border-width: 2px;
    border-color: rgba(232, 200, 105, 0.6);
    border-radius: 16px;
    padding: 24px 28px;
    align-items: center;

    /* Scale-up + fade animation */
    scale: 0.85;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.4s, 0.35s;
    transition-timing-function: ease-out, ease-out;
}

.reward-panel.visible {
    scale: 1;
    opacity: 1;
}

.reward-title {
    font-size: 26px;
    color: #F0D878;
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 0 0 12px rgba(240, 216, 120, 0.5);
    margin-bottom: 8px;
}

.reward-divider {
    width: 80%;
    height: 2px;
    background-color: rgba(200, 170, 80, 0.3);
    margin-bottom: 16px;
}

.reward-items {
    width: 100%;
    align-items: center;
    margin-bottom: 12px;
}

.reward-item-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 6px 12px;
    background-color: rgba(200, 170, 80, 0.06);
    border-radius: 6px;
    width: 90%;

    /* Pop-in animation */
    scale: 0.7;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.35s, 0.3s;
    transition-timing-function: ease-out, ease-out;
}

.reward-item-row.visible {
    scale: 1;
    opacity: 1;
}

.reward-item-icon {
    width: 36px;
    height: 36px;
    margin-right: 12px;
    border-width: 1px;
    border-color: rgba(200, 170, 80, 0.3);
    border-radius: 4px;
    background-color: rgba(40, 35, 50, 0.6);
}

.reward-item-name {
    font-size: 15px;
    color: #D8D3C8;
    flex-grow: 1;
}

.reward-item-amount {
    font-size: 14px;
    color: #E8C869;
    -unity-font-style: bold;
}

.reward-exp {
    font-size: 16px;
    color: #A8D8A0;
    -unity-font-style: bold;
    margin-bottom: 14px;

    scale: 0.7;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.35s, 0.3s;
    transition-timing-function: ease-out, ease-out;
}

.reward-exp.visible {
    scale: 1;
    opacity: 1;
}

.btn-reward-close {
    margin-top: 4px;
    padding: 8px 40px;
}

/* ═════════════════════════════════
   QUEST TRACKER (right side HUD)
   ═════════════════════════════════ */
.quest-tracker {
    position: absolute;
    right: 16px;
    top: 160px;
    width: 240px;
    background-color: rgba(8, 6, 18, 0.8);
    border-width: 1px;
    border-color: rgba(200, 170, 80, 0.3);
    border-radius: 10px;
    padding: 10px 14px;

    /* Slide-in from right */
    translate: 60px 0;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.5s, 0.4s;
    transition-timing-function: ease-out, ease-out;
}

.quest-tracker.visible {
    translate: 0 0;
    opacity: 1;
}

.tracker-header {
    font-size: 14px;
    color: #E8C869;
    -unity-font-style: bold;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
}

.tracker-list {
    width: 100%;
}

.tracker-entry {
    margin-bottom: 8px;
    padding: 6px 8px;
    background-color: rgba(200, 170, 80, 0.05);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(200, 170, 80, 0.12);
}

.tracker-entry-title {
    font-size: 13px;
    color: #D8D0B8;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.tracker-entry-progress {
    font-size: 11px;
    color: #A8A088;
    margin-bottom: 4px;
}

.tracker-progress-bar-bg {
    width: 100%;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
}

.tracker-progress-bar-fill {
    height: 100%;
    background-color: #E8C869;
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
}

.tracker-entry-complete {
    border-color: rgba(100, 200, 100, 0.3);
}

.tracker-entry-complete .tracker-entry-title {
    color: #A8E8A0;
}

.tracker-entry-complete .tracker-progress-bar-fill {
    background-color: #80D880;
}
