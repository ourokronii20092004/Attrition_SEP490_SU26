/* ============================================================
   ATTRITION — IN-GAME UI (HUD, Inventory, Fast Travel, Game Over, Loading)
   Dark-fantasy theme. Gold #c9a84c, ash #07080d.

   THEME ART (2026-07-28):
   - Font: BoldPixels (Art/UI_Elements/Fontstyle/boldpixels.ttf).
   - Khung/nút/ô: Ornate Retro UI, bảng BrownFantasy — sprite đã tách sẵn ra
     Art/UI_Elements/OrnateUI/*.png để USS dùng 9-slice (sheet gốc là Multiple,
     USS không tham chiếu sub-sprite được).
   - Thanh HP/Mana/Stamina: GandalfHardcore Hp bar — dải đã tách ra
     Art/UI_Elements/Bars/ (đỏ = HP, xanh = Mana, vàng = Stamina).
   ============================================================ */

/* Font pixel cho TOÀN BỘ UI trong trận. -unity-font-definition: initial là bắt
   buộc khi dùng -unity-font với file .ttf (nếu không Unity vẫn giữ font mặc định). */
#game-root, #game-root Label, #game-root Button, #game-root TextField {
    -unity-font-definition: initial;
    -unity-font: url('../Art/UI_Elements/Fontstyle/boldpixels.ttf');
}

#game-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
}

.overlay-screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}

.hidden { display: none; }

/* ===================== HUD ===================== */

#hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

#hud-topleft {
    position: absolute;
    left: 24px; top: 20px;
    flex-direction: row;
    align-items: center;
}

.hud-decor-bg {
    position: absolute;
    left: -12px; top: -12px; bottom: -12px; right: -12px;
    background-color: rgba(4, 5, 8, 0.6);
    border-radius: 40px;
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.3);
}

.hud-avatar {
    width: 56px; height: 56px;
    border-radius: 28px;
    background-color: rgb(30, 21, 48);
    border-width: 2px;
    border-color: rgba(201, 168, 76, 0.55);
    margin-right: 12px;
}

#hud-bars { width: 240px; }

.stat-bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

/* Rãnh thanh: khung Ornate 9-slice. slice-scale: 1px giữ nét pixel (không kéo mờ). */
.stat-bar-track {
    flex-grow: 1;
    height: 14px;
    background-image: url('../Art/UI_Elements/OrnateUI/bar_track.png');
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 2px; padding-right: 2px;
    padding-top: 2px; padding-bottom: 2px;
    overflow: hidden;
}

/* Fill: dải pixel Gandalf, kéo ngang theo % máu. Slice 2px hai đầu để giữ viền dải. */
.stat-bar-fill {
    height: 100%;
    width: 100%;
    -unity-slice-left: 2;
    -unity-slice-right: 2;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
}

.fill-hp      { background-image: url('../Art/UI_Elements/Bars/fill_hp.png'); }
.fill-mana    { background-image: url('../Art/UI_Elements/Bars/fill_mana.png'); }
.fill-stamina { background-image: url('../Art/UI_Elements/Bars/fill_stamina.png'); }
/* EXP không thuộc bộ Gandalf (chỉ có 3 màu) → giữ màu tím phẳng cho khác biệt rõ. */
.fill-exp { background-color: rgb(140, 82, 255); }

.stat-bar-label {
    width: 64px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 10px;
    -unity-text-align: middle-right;
    margin-left: 6px;
}

.hud-lvl {
    width: auto;
    -unity-text-align: middle-left;
    color: #ebdcb1;
    margin-top: 4px;
    font-size: 12px;
    letter-spacing: 2px;
    text-shadow: 0 0 6px rgba(201, 168, 76, 0.5);
}

/* --- Bottom bar: flasks + skill --- */
#hud-bottomleft {
    position: absolute;
    left: 24px; bottom: 22px;
    flex-direction: row;
    align-items: flex-end;
}

.hud-decor-bg-small {
    position: absolute;
    left: -8px; top: -8px; bottom: -8px; right: -8px;
    background-color: rgba(4, 5, 8, 0.6);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.3);
}

.hud-slot {
    width: 56px; height: 56px;
    border-radius: 6px;
    background-color: rgba(8, 10, 16, 0.85);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.35);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
}

.hud-slot.skill {
    width: 64px; height: 64px;
    border-color: rgba(201, 168, 76, 0.6);
}

.hud-slot-icon {
    width: 32px; height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-slot-count {
    position: absolute;
    right: 3px; bottom: 1px;
    color: #e8d8a8;
    font-size: 13px;
    -unity-text-align: lower-right;
}

.hud-slot-key {
    position: absolute;
    left: 3px; top: 1px;
    color: rgba(255, 255, 255, 0.45);
    font-size: 9px;
}

.hud-slot-empty { opacity: 0.4; }

/* --- Coop ping (top-right) --- */
#hud-ping {
    position: absolute;
    right: 20px; top: 16px;
    flex-direction: row;
    align-items: center;
}
#hud-ping-dot {
    width: 8px; height: 8px;
    border-radius: 4px;
    margin-right: 7px;
    background-color: rgb(64, 200, 96);
}
#hud-ping-label {
    color: #ebdcb1;
    font-size: 12px;
    -unity-font-style: bold;
}
.ping-good { background-color: rgb(64, 200, 96); }
.ping-ok { background-color: rgb(200, 160, 64); }
.ping-bad { background-color: rgb(200, 64, 64); }

/* --- FPS counter (top-right, below ping) --- */
#hud-fps {
    position: absolute;
    right: 20px; top: 40px;
    flex-direction: row;
    align-items: center;
}
#hud-fps-label {
    color: #ebdcb1;
    font-size: 12px;
    -unity-font-style: bold;
}
.fps-good { color: rgb(120, 220, 140); }
.fps-ok { color: rgb(220, 190, 110); }
.fps-bad { color: rgb(230, 120, 120); }

/* --- Boss bar (bottom center) --- */
#hud-boss {
    position: absolute;
    bottom: 60px; left: 50%;
    translate: -50% 0;
    width: 600px;
    align-items: center;
}

#hud-boss-name {
    color: #e8d8a8;
    font-size: 14px;
    letter-spacing: 4px;
    margin-bottom: 4px;
    text-shadow: 0 2px 6px rgba(0,0,0,0.9);
}

#hud-boss-track {
    width: 100%;
    height: 10px;
    background-color: rgba(0,0,0,0.7);
    border-width: 1px;
    border-color: rgba(120, 30, 30, 0.8);
    overflow: hidden;
}

#hud-boss-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(150, 32, 32);
}

/* --- Interaction prompt (Rest, pickup) --- */
#hud-prompt {
    position: absolute;
    bottom: 120px; left: 50%;
    translate: -50% 0;
    padding: 6px 16px;
    background-color: rgba(8, 10, 16, 0.85);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.4);
    border-radius: 4px;
}

#hud-prompt-text {
    color: #e8d8a8;
    font-size: 12px;
    letter-spacing: 2px;
}

/* --- Coop revive prompt (giữ R để hồi sinh đồng đội) --- */
#hud-revive {
    position: absolute;
    bottom: 160px; left: 50%;
    translate: -50% 0;
    padding: 6px 16px;
    background-color: rgba(8, 10, 16, 0.85);
    border-width: 1px;
    border-color: rgba(120, 30, 30, 0.8);
    border-radius: 4px;
    align-items: center;
}

#hud-revive-text {
    color: #f0c0a0;
    font-size: 12px;
    letter-spacing: 2px;
}

#hud-revive-track {
    margin-top: 5px;
    width: 160px;
    height: 6px;
    background-color: rgba(0,0,0,0.7);
    border-width: 1px;
    border-color: rgba(120, 30, 30, 0.8);
    overflow: hidden;
}

#hud-revive-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(150, 32, 32);
}

/* ===================== CHARACTER / INVENTORY ===================== */
#inv-dim {
    background-color: rgba(4, 3, 10, 0.82);
}

#inv-panel {
    flex-direction: row;
    width: 920px;
    height: 560px;
    background-color: rgba(6, 6, 8, 0.98); /* Deep obsidian */
    border-width: 2px;
    border-color: rgba(180, 140, 50, 0.6); /* Gold rim */
    border-radius: 16px;
    overflow: hidden;
}

/* Ornate decorative divider */
.fancy-divider {
    height: 2px;
    width: 100%;
    background-color: rgba(201, 168, 76, 0.35);
    margin: 8px 0;
    border-radius: 1px;
}

.ornate-header {
    align-items: center;
    margin-bottom: 6px;
}

/* Left: character + equip */
#inv-left {
    width: 340px;
    padding: 22px;
    border-right-width: 1px;
    border-right-color: rgba(201, 168, 76, 0.12);
    align-items: center;
}

#inv-char-name {
    color: #e8d8a8; /* Parchment */
    font-size: 20px;
    letter-spacing: 6px;
    margin-bottom: 2px;
    text-shadow: 0 4px 10px rgba(201, 168, 76, 0.4);
}

#inv-char-level {
    color: rgba(201, 168, 76, 0.8);
    font-size: 11px;
    letter-spacing: 4px;
    margin-bottom: 10px;
}

#inv-equip-row {
    flex-direction: row;
    justify-content: center;
}

.equip-col { align-items: center; }

.equip-slot {
    width: 52px; height: 52px;
    border-radius: 8px;
    background-color: rgba(2, 2, 3, 0.8);
    border-top-width: 1px;
    border-left-width: 1px;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-top-color: rgba(20, 20, 20, 0.9);
    border-left-color: rgba(20, 20, 20, 0.9);
    border-bottom-color: rgba(201, 168, 76, 0.4);
    border-right-color: rgba(201, 168, 76, 0.4);
    align-items: center;
    justify-content: center;
    margin: 6px;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.2s;
}

.equip-slot:hover { 
    border-top-color: rgba(201, 168, 76, 0.9); 
    border-left-color: rgba(201, 168, 76, 0.9); 
    background-color: rgba(201, 168, 76, 0.15);
    scale: 1.08;
}
.equip-slot.skill { border-bottom-color: rgba(201, 168, 76, 0.7); border-right-color: rgba(201, 168, 76, 0.7); }

.equip-slot-icon {
    width: 36px; height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

#inv-avatar {
    width: 96px; height: 96px;
    border-radius: 48px;
    background-color: rgb(16, 12, 22);
    border-width: 2px;
    border-color: rgba(201, 168, 76, 0.6);
    margin: 4px;
}

/* stat grid */
#inv-stats {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
    margin-top: 16px;
}

.stat-cell {
    width: 47%;
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 10px;
    margin-bottom: 6px;
    background-color: rgba(0,0,0,0.6);
    border-radius: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 168, 76, 0.2);
}

.stat-cell-key { color: rgba(255,255,255,0.55); font-size: 11px; letter-spacing: 1px; }
.stat-cell-val { color: #e8d8a8; font-size: 12px; }

/* stat allocation (Option 2: 5 free points/level) */
#inv-points {
    color: #c9a84c;
    font-size: 11px;
    letter-spacing: 2px;
    margin-top: 12px;
    margin-bottom: 4px;
}

.alloc-btn {
    width: 20px; height: 20px;
    border-radius: 3px;
    background-color: rgba(201, 168, 76, 0.18);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.45);
    color: #e8d8a8;
    font-size: 13px;
    -unity-text-align: middle-center;
    margin-left: 6px;
    padding: 0;
}

.alloc-btn:hover { background-color: rgba(201, 168, 76, 0.32); }
.alloc-btn:disabled { opacity: 0.25; }

/* Right: inventory grid */
#inv-right {
    flex-grow: 1;
    padding: 22px;
}

#inv-tabs {
    flex-direction: row;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255,255,255,0.07);
}

.inv-tab {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    color: rgba(255,255,255,0.4);
    font-size: 12px;
    letter-spacing: 3px;
    padding: 6px 16px;
}

.inv-tab:hover { color: rgba(255,255,255,0.7); }
.inv-tab.active { color: #e8d8a8; border-bottom-color: #c9a84c; }

#inv-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    align-content: flex-start;
}

.inv-cell {
    width: 52px; height: 52px;
    margin: 4px;
    border-radius: 6px;
    background-color: rgba(4, 5, 8, 0.85);
    border-top-width: 1px;
    border-left-width: 1px;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-top-color: rgba(10, 10, 10, 0.9);
    border-left-color: rgba(10, 10, 10, 0.9);
    border-bottom-color: rgba(201, 168, 76, 0.3);
    border-right-color: rgba(201, 168, 76, 0.3);
    align-items: center;
    justify-content: center;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.15s;
}

.inv-cell:hover { 
    border-top-color: rgba(201, 168, 76, 0.85); 
    border-left-color: rgba(201, 168, 76, 0.85); 
    background-color: rgba(201, 168, 76, 0.2);
    scale: 1.05;
}
.inv-cell.selected { border-top-color: #e8c873; border-left-color: #e8c873; background-color: rgba(201,168,76,0.3); }

.inv-cell-icon {
    width: 38px; height: 38px;
    -unity-background-scale-mode: scale-to-fit;
}

.inv-cell-count {
    position: absolute;
    right: 3px; bottom: 1px;
    color: #ffffff;
    font-size: 11px;
}

#inv-weight-row {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

#inv-weight-track {
    flex-grow: 1;
    height: 6px;
    background-color: rgba(0,0,0,0.5);
    border-radius: 3px;
    overflow: hidden;
    margin-right: 8px;
}

#inv-weight-fill {
    height: 100%;
    background-color: rgba(201, 168, 76, 0.6);
}

#inv-weight-label { color: rgba(255,255,255,0.45); font-size: 10px; }

/* item detail popup */
#inv-detail {
    position: absolute;
    right: 20px; top: 60px;
    width: 240px;
    padding: 18px;
    background-color: rgba(6, 6, 8, 0.98);
    border-width: 2px;
    border-color: rgba(180, 140, 50, 0.6);
    border-radius: 8px;
}

#inv-detail-name {
    color: #e8d8a8;
    font-size: 16px;
    letter-spacing: 2px;
    margin-bottom: 2px;
    white-space: normal;
    text-shadow: 0 2px 8px rgba(201, 168, 76, 0.5);
}

#inv-detail-desc {
    color: rgba(255,255,255,0.55);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 10px;
}

#inv-detail-mods { margin-bottom: 12px; }

.detail-mod { color: rgb(120, 200, 120); font-size: 11px; }

.detail-btn {
    height: 30px;
    border-radius: 4px;
    background-color: rgba(201, 168, 76, 0.18);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.45);
    color: #e8d8a8;
    font-size: 11px;
    letter-spacing: 2px;
    margin-top: 6px;
}

.detail-btn:hover { background-color: rgba(201, 168, 76, 0.3); }
.detail-btn.drop { border-color: rgba(180,60,60,0.5); color: rgba(220,120,120,0.9); background-color: rgba(180,40,40,0.12); }

/* ===================== BONFIRE / CHECKPOINT ===================== */
#ft-dim { background-color: rgba(4, 3, 10, 0.85); }

.bonfire-menu {
    width: 280px;
    align-items: center;
    background-color: transparent;
}

.bonfire-title {
    color: #ebdcb1;
    font-size: 28px;
    letter-spacing: 6px;
    margin-bottom: 8px;
    text-shadow: 0 0 10px rgba(201, 168, 76, 0.6);
}

.bonfire-btn {
    width: 100%;
    height: 48px;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 1px;
    border-color: rgba(201, 168, 76, 0.2);
    color: #d1c9c0;
    font-size: 16px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    transition-property: color, scale, background-color;
    transition-duration: 0.2s;
}

.bonfire-btn:hover {
    color: #ebdcb1;
    background-color: rgba(201, 168, 76, 0.15);
    scale: 1.05;
}

.bonfire-btn.half { width: 48%; margin: 0 1%; }

.bonfire-popup {
    width: 420px;
    background-color: rgba(6, 6, 8, 0.98);
    border-width: 2px;
    border-color: rgba(180, 140, 50, 0.6);
    border-radius: 12px;
    padding: 24px;
    align-items: center;
}

.popup-title {
    color: #ebdcb1;
    font-size: 20px;
    letter-spacing: 4px;
    margin-bottom: 8px;
    text-shadow: 0 0 8px rgba(201, 168, 76, 0.4);
}

.unspent-label {
    color: #c9a84c;
    font-size: 14px;
    letter-spacing: 2px;
    margin: 12px 0;
}

.alloc-list { width: 100%; margin-bottom: 16px; }

.alloc-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 36px;
    border-bottom-width: 1px;
    border-color: rgba(255,255,255,0.05);
}

.alloc-name { color: #d1c9c0; font-size: 12px; letter-spacing: 1px; width: 120px; }
.alloc-val { color: #ebdcb1; font-size: 14px; flex-grow: 1; -unity-text-align: middle-right; margin-right: 16px; }

.plus-btn {
    width: 32px; height: 28px;
    background-color: rgba(201, 168, 76, 0.2);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.5);
    color: #ebdcb1;
    border-radius: 4px;
    font-size: 16px;
}
.plus-btn:hover { background-color: rgba(201, 168, 76, 0.4); }

.flask-alloc-container {
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    margin-bottom: 24px;
    margin-top: 12px;
}

.flask-col { align-items: center; }

.flask-name {
    color: #d1c9c0;
    font-size: 12px;
    letter-spacing: 1px;
    margin-top: 12px;
    margin-bottom: 8px;
}

.flask-stepper {
    flex-direction: row;
    align-items: center;
}

.stepper-btn {
    width: 32px; height: 32px;
    background-color: rgba(201, 168, 76, 0.2);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.5);
    color: #ebdcb1;
    border-radius: 4px;
    font-size: 14px;
}
.stepper-btn:hover { background-color: rgba(201, 168, 76, 0.4); }

.stepper-val {
    color: #ebdcb1;
    font-size: 20px;
    width: 48px;
    -unity-text-align: middle-center;
}

.popup-actions {
    flex-direction: row;
    width: 100%;
    justify-content: center;
    margin-top: 12px;
}

#ft-panel {
    flex-direction: row;
    width: 100%;
    height: 300px;
}

#ft-list-col { width: 220px; padding-right: 12px; border-right-width: 1px; border-color: rgba(201, 168, 76, 0.2); }
#ft-preview-col { flex-grow: 1; padding-left: 12px; justify-content: space-between; }
#ft-count { color: #c9a84c; font-size: 10px; letter-spacing: 2px; margin-bottom: 8px; }

#ft-preview {
    flex-grow: 1;
    background-color: rgba(0,0,0,0.3);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

#ft-preview-name {
    color: #ebdcb1;
    font-size: 18px;
    letter-spacing: 3px;
    white-space: normal;
    max-width: 220px;
    -unity-text-align: middle-center;
}
#ft-preview-region {
    color: rgba(255,255,255,0.4);
    font-size: 11px;
    white-space: normal;
    max-width: 220px;
    -unity-text-align: middle-center;
}

.ft-btn.go {
    background-color: rgba(201, 168, 76, 0.2);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.5);
    color: #ebdcb1;
    height: 40px;
    border-radius: 4px;
}
.ft-btn.go:hover { background-color: rgba(201, 168, 76, 0.4); }

.ft-item {
    padding: 8px;
    border-bottom-width: 1px;
    border-color: rgba(255,255,255,0.05);
    color: #d1c9c0;
    background-color: transparent;
}
.ft-item:hover { background-color: rgba(255,255,255,0.05); }
.ft-item.selected { color: #ebdcb1; background-color: rgba(201, 168, 76, 0.2); }

/* ===================== GAME OVER ===================== */
#go-dim { background-color: rgba(8, 2, 2, 0.9); }

#go-content { align-items: center; width: 480px; }

#go-sigil {
    width: 64px; height: 64px;
    border-radius: 32px;
    border-width: 2px;
    border-color: rgba(180, 40, 40, 0.6);
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
}

#go-sigil-icon { color: rgb(200, 60, 60); font-size: 30px; }

#go-title {
    color: rgb(200, 56, 56);
    font-size: 40px;
    letter-spacing: 8px;
    -unity-text-align: middle-center;
    text-shadow: 0 4px 16px rgba(0,0,0,0.9);
    margin-bottom: 6px;
}

#go-subtitle {
    color: rgba(255,255,255,0.5);
    font-size: 13px;
    letter-spacing: 3px;
    margin-bottom: 24px;
}

#go-stats {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 28px;
}

.go-stat { align-items: center; margin: 0 22px; }
.go-stat-val { color: #e8d8a8; font-size: 22px; }
.go-stat-key { color: rgba(255,255,255,0.4); font-size: 10px; letter-spacing: 2px; }

#go-actions { flex-direction: row; }

.go-btn {
    height: 44px;
    padding: 0 26px;
    margin: 0 8px;
    border-radius: 5px;
    font-size: 12px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.go-btn.resume {
    background-color: rgba(201, 168, 76, 0.2);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.5);
    color: #e8d8a8;
}

.go-btn.resume:hover { background-color: rgba(201, 168, 76, 0.32); }

.go-btn.quit {
    background-color: rgba(0,0,0,0.5);
    border-width: 1px;
    border-color: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.5);
}

/* ===================== LOADING ===================== */
#loading { background-color: #07080d; }

#loading-content { align-items: center; width: 560px; }

#loading-title {
    color: #ffffff;
    font-size: 30px;
    letter-spacing: 10px;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
    text-shadow: 0 4px 16px rgba(0,0,0,0.9);
}

#loading-area {
    color: #c9a84c;
    font-size: 13px;
    letter-spacing: 4px;
    margin-bottom: 32px;
}

#loading-track {
    width: 100%;
    height: 6px;
    background-color: rgba(255,255,255,0.08);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 10px;
}

#loading-fill {
    height: 100%;
    width: 0;
    background-color: #c9a84c;
}

#loading-status {
    color: rgba(255,255,255,0.45);
    font-size: 11px;
    letter-spacing: 2px;
    margin-bottom: 28px;
}

#loading-tip {
    color: rgba(255,255,255,0.3);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 480px;
}

/* reconnect (coop) variant reuses loading; countdown emphasis */
#loading-countdown {
    color: rgb(200, 120, 60);
    font-size: 13px;
    letter-spacing: 2px;
    margin-top: 6px;
}

/* ===================== PAUSE (ESC) ===================== */
#pause-dim { background-color: rgba(4, 3, 10, 0.88); }

#pause-content { align-items: center; width: 360px; }

#pause-title {
    color: #e8d8a8;
    font-size: 30px;
    letter-spacing: 10px;
    -unity-text-align: middle-center;
    text-shadow: 0 4px 16px rgba(0,0,0,0.9);
    margin-bottom: 32px;
}

#pause-actions { width: 100%; align-items: center; }

.pause-btn {
    width: 100%;
    height: 46px;
    margin-bottom: 12px;
    border-radius: 5px;
    font-size: 12px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    background-color: rgba(0,0,0,0.5);
    border-width: 1px;
    border-color: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.6);
}

.pause-btn:hover {
    border-color: rgba(201, 168, 76, 0.5);
    color: #e8d8a8;
}

.pause-btn.resume {
    background-color: rgba(201, 168, 76, 0.2);
    border-color: rgba(201, 168, 76, 0.5);
    color: #e8d8a8;
}

.pause-btn.resume:hover { background-color: rgba(201, 168, 76, 0.32); }

.pause-btn.quit:hover {
    border-color: rgba(180, 60, 60, 0.6);
    color: rgb(220, 130, 130);
}

/* ===================== SETTINGS (in-game) ===================== */
#set-dim { background-color: rgba(4, 3, 10, 0.9); }

#set-content {
    width: 520px;
    max-height: 88%;
    padding: 28px 32px;
    background-color: rgba(8, 10, 16, 0.97);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.25);
    border-radius: 10px;
}

#set-title {
    color: #e8d8a8;
    font-size: 22px;
    letter-spacing: 8px;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.set-section {
    color: #c9a84c;
    font-size: 11px;
    letter-spacing: 3px;
    margin-top: 14px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 168, 76, 0.15);
    padding-bottom: 4px;
}

.set-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.set-row-key {
    width: 90px;
    color: rgba(255,255,255,0.65);
    font-size: 12px;
}

.set-row-key.wide {
    width: 220px;
    flex-grow: 1;
}

.set-slider { flex-grow: 1; }

.set-row-val {
    width: 46px;
    color: #e8d8a8;
    font-size: 12px;
    -unity-text-align: middle-right;
}

#set-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 22px;
}

.set-btn {
    height: 40px;
    padding: 0 22px;
    margin-left: 10px;
    border-radius: 5px;
    font-size: 11px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    background-color: rgba(0,0,0,0.5);
    border-width: 1px;
    border-color: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.55);
}

.set-btn:hover { border-color: rgba(201,168,76,0.5); color: #e8d8a8; }

.set-btn.primary {
    background-color: rgba(201, 168, 76, 0.2);
    border-color: rgba(201, 168, 76, 0.5);
    color: #e8d8a8;
}

.set-btn.primary:hover { background-color: rgba(201, 168, 76, 0.32); }

/* ============================================================
   VISUAL POLISH OVERRIDES (in-game) — chỉ style, không đổi tên/logic
   ============================================================ */

/* Nền overlay sâu hơn cho pause/settings/inventory */
#pause-dim, #set-dim, #inv-dim {
    background-color: rgba(3, 2, 8, 0.78);
}

/* Pause title + content */
#pause-title {
    color: #fbf4e0;
    letter-spacing: 8px;
    text-shadow: 0 4px 18px rgba(201, 168, 76, 0.3);
}

.pause-btn {
    border-radius: 6px;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.18s;
}
.pause-btn:hover { scale: 1.04; }
.pause-btn.resume {
    border-color: rgba(201, 168, 76, 0.55);
}
.pause-btn.quit:hover {
    color: #ff9b8a;
}

/* Settings panel: kính tối + viền vàng */
#set-content {
    background-color: rgba(10, 9, 16, 0.97);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.3);
    border-radius: 12px;
}
#set-title {
    color: #fbf4e0;
    letter-spacing: 6px;
}
.set-section {
    color: #c9a84c;
}

/* HUD bars: bo góc + viền tinh tế cho nổi khối */
.stat-bar-track {
    border-radius: 4px;
}
.stat-bar-fill {
    border-radius: 3px;
}

/* Boss bar nổi bật hơn */
#hud-boss-name {
    color: #f3d9a0;
    text-shadow: 0 2px 10px rgba(150, 30, 30, 0.7);
}

/* Inventory panel viền vàng ấm + bo góc lớn */
#inv-panel {
    border-color: rgba(201, 168, 76, 0.32);
    border-radius: 12px;
}
.inv-tab.active {
    color: #f3e6bd;
}
.inv-cell.selected {
    border-color: #e8c873;
}

/* ============================================================
   WAITING FOR PLAYER (coop — client mất kết nối)
   ============================================================ */
#waiting-dim {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(3, 2, 8, 0.85);
}
#waiting-content {
    align-items: center;
    width: 460px;
}
#waiting-title {
    color: #fbf4e0;
    font-size: 26px;
    letter-spacing: 6px;
    text-shadow: 0 4px 18px rgba(201, 168, 76, 0.3);
    margin-bottom: 12px;
}
#waiting-desc {
    color: rgba(255,255,255,0.5);
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}
#waiting-spinner {
    width: 36px;
    height: 36px;
    border-width: 3px;
    border-color: rgba(201, 168, 76, 0.25);
    border-top-color: #c9a84c;
    border-radius: 18px;
}

/* ============================================================
/* ============================================================
   ORNATE RETRO UI THEME (BrownFantasy) — sửa 2026-07-28 (lần 2)

   LẦN ĐẦU BỊ LOẠN vì 2 lỗi, nay đã sửa:
   1. Slice VƯỢT kích thước sprite. VD button cao 18px mà đặt slice
      top+bottom = 8+8 = 16px → chỉ còn 2px ở giữa để kéo giãn nên khung
      bị bóp méo. Giờ mọi giá trị slice đo TỪ ẢNH THẬT và kẹp lại sao cho
      (2 cạnh) <= (kích thước - 2).
   2. Không tắt nền/viền cũ → khung Ornate vẽ ĐÈ lên viền vàng + bo góc cũ,
      thành 2 lớp khung lồng nhau. Giờ mọi selector đều ép
      background-color: transparent + border-width 0 + border-radius 0.

   Số slice thật (rộng x cao → left/right/top/bottom):
     panel        98x98 → 26/26/22/20      slot      50x50 → 7/6/7/9
     panel_alt    98x96 → 26/26/20/20      slot_sel  50x50 → 6/6/6/9
     header       47x16 → 16/15/7/7        button    50x18 → 7/6/7/8
     bar_track    84x15 → 9/9/6/6          btn_hover 50x18 → 6/6/6/7
                                           btn_press 50x16 → 7/6/7/7
   ============================================================ */

/* ---------- KHUNG PANEL LỚN ---------- */
#inv-panel,
#pause-content,
#set-content,
#go-content {
    background-image: url('../Art/UI_Elements/OrnateUI/panel.png');
    -unity-slice-left: 26;
    -unity-slice-right: 26;
    -unity-slice-top: 22;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding-left: 30px; padding-right: 30px;
    padding-top: 26px; padding-bottom: 24px;
}

/* Vùng lồng bên trong dùng khung nhạt hơn để phân lớp. */
#inv-detail,
#ft-preview,
#waiting-content {
    background-image: url('../Art/UI_Elements/OrnateUI/panel_alt.png');
    -unity-slice-left: 26;
    -unity-slice-right: 26;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

/* ---------- Ô CHỨA ĐỒ / TRANG BỊ ---------- */
.inv-cell,
.equip-slot,
.hud-slot {
    background-image: url('../Art/UI_Elements/OrnateUI/slot.png');
    -unity-slice-left: 7;
    -unity-slice-right: 6;
    -unity-slice-top: 7;
    -unity-slice-bottom: 9;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

.inv-cell.selected,
.equip-slot:hover {
    background-image: url('../Art/UI_Elements/OrnateUI/slot_sel.png');
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 9;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* ---------- NÚT ---------- */
.bonfire-btn,
.detail-btn,
.plus-btn,
.ft-row,
#go-resume,
#go-quit {
    background-image: url('../Art/UI_Elements/OrnateUI/button.png');
    -unity-slice-left: 7;
    -unity-slice-right: 6;
    -unity-slice-top: 7;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: #f0e0b8;
}

.bonfire-btn:hover,
.detail-btn:hover,
.plus-btn:hover,
.ft-row:hover,
.ft-row.selected,
#go-resume:hover,
#go-quit:hover {
    background-image: url('../Art/UI_Elements/OrnateUI/button_hover.png');
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 7;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: #fff6d8;
}

.bonfire-btn:active,
.detail-btn:active,
.plus-btn:active,
.ft-row:active {
    background-image: url('../Art/UI_Elements/OrnateUI/button_press.png');
    -unity-slice-left: 7;
    -unity-slice-right: 6;
    -unity-slice-top: 7;
    -unity-slice-bottom: 7;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* ---------- THANH HP / MANA / STAMINA ---------- */
/* Rãnh: khung Gandalf Hp bar (dùng luôn theo yêu cầu). Cao 16px để vừa viền
   trên+dưới của sprite (6+6) mà còn chỗ cho fill. */
.stat-bar-track {
    height: 16px;
    background-image: url('../Art/UI_Elements/OrnateUI/bar_track.png');
    -unity-slice-left: 9;
    -unity-slice-right: 9;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding-left: 3px; padding-right: 3px;
    padding-top: 3px; padding-bottom: 3px;
    overflow: hidden;
}

/* Fill: dải pixel Gandalf. Chỉ slice NGANG (2px mỗi đầu) — dải chỉ cao 4-6px
   nên KHÔNG slice dọc, nếu không sẽ bị bóp mất phần giữa. */
.stat-bar-fill {
    height: 100%;
    width: 100%;
    -unity-slice-left: 2;
    -unity-slice-right: 2;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

.fill-hp      { background-image: url('../Art/UI_Elements/Bars/fill_hp.png'); }
.fill-mana    { background-image: url('../Art/UI_Elements/Bars/fill_mana.png'); }
.fill-stamina { background-image: url('../Art/UI_Elements/Bars/fill_stamina.png'); }
.fill-exp     { background-color: rgb(140, 82, 255); }

/* ---------- CHỮ PIXEL ---------- */
/* Font pixel cỡ nhỏ: bỏ giãn chữ + shadow cho khỏi nhoè. */
.stat-bar-label,
.hud-slot-count,
.hud-slot-key {
    letter-spacing: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* ---------- THANH LOAD trong trận (#loading-* thuộc GameUI.uxml) ---------- */
#loading-track {
    background-image: url('../Art/UI_Elements/OrnateUI/bar_track.png');
    -unity-slice-left: 9;
    -unity-slice-right: 9;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    height: 16px;
    padding-left: 3px; padding-right: 3px;
    padding-top: 3px; padding-bottom: 3px;
    overflow: hidden;
}

#loading-fill {
    background-image: url('../Art/UI_Elements/Bars/fill_stamina.png');
    -unity-slice-left: 2;
    -unity-slice-right: 2;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    height: 100%;
}

/* ============================================================
   FIX LAYOUT TAB (inventory) — 2026-07-28
   TRIỆU CHỨNG: cột trái (trang bị / HP-Mana-Stamina / chỉ số) đè lên nhau.
   NGUYÊN NHÂN: #inv-panel có height 560px CỐ ĐỊNH + overflow: hidden. Khi theme
   Ornate thêm padding (26+24px) và thanh cao 16px, tổng nội dung cột trái vượt
   quá 560px → các khối bị bóp/chồng lên nhau.
   CÁCH SỬA: nới panel (1040x660), nới cột trái 340→400px, và cho cột trái tự
   cuộn khi vẫn thiếu chỗ thay vì cắt cụt.
   Đặt CUỐI FILE để thắng cascade (#inv-panel khai báo 3 lần ở trên).
   ============================================================ */

#inv-panel {
    width: 1040px;
    height: 660px;
    overflow: hidden;
}

#inv-left {
    width: 400px;
    padding-left: 20px; padding-right: 20px;
    padding-top: 16px; padding-bottom: 16px;
    align-items: center;
    flex-shrink: 0;
}

#inv-right {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 20px; padding-right: 20px;
    padding-top: 16px; padding-bottom: 16px;
    overflow: hidden;
}

/* Ô trang bị: giữ 52px nhưng giảm margin để 4 ô + avatar vừa bề ngang 400px. */
.equip-slot {
    width: 52px; height: 52px;
    margin-left: 5px; margin-right: 5px;
    margin-top: 5px; margin-bottom: 5px;
    flex-shrink: 0;
}

#inv-equip-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin-top: 4px;
}

/* Avatar nhỏ lại một chút để hàng trang bị không bị đẩy rộng quá cột. */
#inv-avatar {
    width: 84px; height: 84px;
    border-radius: 42px;
    margin-left: 6px; margin-right: 6px;
}

/* Chỉ số: 2 cột, chừa khoảng giữa rõ ràng để chữ không dính nhau. */
#inv-stats {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
    margin-top: 12px;
    flex-shrink: 0;
}

.stat-cell {
    width: 48%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 10px; padding-right: 10px;
    padding-top: 5px; padding-bottom: 5px;
    margin-bottom: 6px;
    min-height: 26px;
}

.stat-cell-key { font-size: 11px; letter-spacing: 0; }
.stat-cell-val { font-size: 12px; letter-spacing: 0; }

/* Khối thanh HP/Mana/Stamina trong Tab: mỗi hàng cao hơn cho vừa khung 16px. */
#inv-bars {
    width: 100%;
    align-self: center;
    margin-top: 12px;
    flex-shrink: 0;
}

#inv-bars .stat-bar-row {
    margin-bottom: 7px;
    min-height: 18px;
    align-items: center;
}

/* ============================================================
/* ============================================================
   HUD — KHUNG HP BAR GANDALF (sửa 2026-07-28, lần 3)

   BỐ CỤC (gốc trên-trái sprite 116x64 → USS = x4):
     HP      = ORB TRÒN bên trái, lòng orb x4..54  y4..57  (51x54)
     Stamina = rãnh TRÊN          x67..95  y47..50 (29x4)
     Mana    = rãnh DƯỚI          x63..111 y54..59 (49x6)
   Scale x4 (trước x3) cho chữ + thanh dễ đọc → khung 464x256.

   SỬA 3 LỖI user báo:
   1. "Orb lệch trái, chưa lấp đầy bên phải": `red bar.png` là 56x54 nhưng lòng
      orb chỉ 51x54 → ảnh RỘNG HƠN lòng 5px. Trước tôi đặt fill = 100% chiều
      rộng của ô 51px nên ảnh bị co lại, hụt bên phải. Nay đặt fill ĐÚNG kích
      thước ảnh (56x54 → 224x216) và lệch left -8px để phần màu trùng lòng orb.
   2. "Tụt thẳng thay vì xéo": trước đổi height của FILL + scale-and-crop → Unity
      CO ảnh theo chiều cao nên mép nước phẳng ngang. Nay đổi height của TRACK
      (cửa sổ cắt) còn fill giữ nguyên cỡ ảnh → cắt lộ dần, mép nước cong theo
      viền cầu đúng như 2 lần tụt đầu.
   3. EXP + LV: EXP là thanh riêng ngay dưới khung; LV cỡ 16px cho dễ nhìn.
   ============================================================ */

#hud-topleft {
    position: absolute;
    left: 16px; top: 12px;
    width: 464px;
    height: 256px;
    flex-direction: column;
    align-items: flex-start;
    background-image: url('../Art/UI_Elements/Bars/gandalf_frame.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
}

/* Art đã có orb + khung sẵn → bỏ nền trang trí và avatar tròn cũ. */
.hud-decor-bg { display: none; }
.hud-avatar { display: none; }

#hud-bars {
    position: absolute;
    left: 0; top: 0;
    width: 464px;
    height: 256px;
    background-color: rgba(0, 0, 0, 0);
}

#hud-hp-row, #hud-mana-row, #hud-stamina-row {
    position: absolute;
    flex-direction: row;
    margin: 0;
    padding: 0;
}

/* HP = ORB TRÒN. Hàng chỉ là mốc vị trí; TRACK bên trong mới là cửa sổ cắt. */
#hud-hp-row {
    left: 16px; top: 16px;      /* offset khop nhat do bang correlation: dx=4 dy=4 (*4) */
    width: 224px;               /* = ANH red bar 56*4, KHONG phai long orb 51*4 */
    height: 216px;              /* = 54*4 */
    flex-direction: column;
    justify-content: flex-end;  /* nuoc dang tu DAY */
}

#hud-stamina-row { left: 268px; top: 188px; width: 116px; height: 16px; } /* x67 y47 w29 h4 */
#hud-mana-row    { left: 252px; top: 216px; width: 196px; height: 24px; } /* x63 y54 w49 h6 */

/* TRACK của orb = CỬA SỔ CẮT. C# đổi HEIGHT của phần tử này theo % máu;
   overflow: hidden cắt bớt phần TRÊN của ảnh, fill giữ nguyên cỡ nên mép nước
   cong theo viền cầu. justify-content: flex-end ghim ảnh xuống đáy. */
#hud-hp-row > .stat-bar-track {
    /* flex-grow: 0 LA BAT BUOC: base class .stat-bar-track co flex-grow:1, ma trong
       flexbox flex-grow THANG height inline -> track luon gian full 216px nen
       SetFillVertical doi height khong co tac dung => HP khong tut (bug user bao). */
    flex-grow: 0;
    flex-shrink: 0;
    width: 224px;
    height: 100%;
    flex-direction: column;
    justify-content: flex-end;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding: 0;
    overflow: hidden;
}

/* FILL orb: ĐÚNG kích thước ảnh gốc (56x54 * 4), KHÔNG co giãn, KHÔNG slice.
   Lệch trái -8px (= -2 * 4) vì ảnh rộng 56 mà lòng orb chỉ 51 → căn cho phần
   màu trùng đúng lòng. flex-shrink: 0 để flexbox không bóp lại khi track thu nhỏ. */
#hud-hp-row .stat-bar-fill {
    width: 224px;
    height: 216px;
    flex-shrink: 0;             /* KHONG cho flexbox bop lai khi track co */
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

/* 2 rãnh: track trong suốt (rãnh đã vẽ trong art), fill kéo ngang theo %. */
#hud-mana-row > .stat-bar-track,
#hud-stamina-row > .stat-bar-track {
    flex-grow: 1;
    height: 100%;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding: 0;
    overflow: hidden;
}

#hud-mana-row .stat-bar-fill,
#hud-stamina-row .stat-bar-fill {
    height: 100%;
    -unity-slice-left: 2;
    -unity-slice-right: 2;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

/* Khung không có chỗ cho chữ số → ẩn label trên HUD (Tab vẫn hiện đủ). */
#hud-hp-label, #hud-mana-label, #hud-stamina-label { display: none; }

/* ---------- EXP: thanh riêng NGAY DƯỚI khung (khung chỉ có 2 rãnh) ---------- */
#hud-exp-row {
    position: absolute;
    left: 252px; top: 248px;
    width: 196px;
    height: 24px;              /* bang thanh mana (24px) cho dong bo */
    flex-direction: row;
    margin: 0;
    padding: 0;
}

#hud-exp-track {
    /* Mana/Stamina co khung ve san trong art Gandalf; EXP nam NGOAI khung nen
       phai tu dap khung Ornate bar_track cho dong bo (yeu cau user). */
    flex-grow: 1;
    height: 100%;
    background-image: url('../Art/UI_Elements/OrnateUI/bar_track.png');
    -unity-slice-left: 9;
    -unity-slice-right: 9;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding-left: 4px; padding-right: 4px;
    padding-top: 4px; padding-bottom: 4px;
    overflow: hidden;
}

#hud-exp-fill {
    height: 100%;
    background-color: rgb(150, 90, 255);
    background-image: none;
    border-width: 0;
    border-radius: 0;
}

/* LV: to hơn (16px) + đặt dưới orb cho khỏi chồng art. */
.hud-lvl {
    position: absolute;
    left: 20px; top: 234px;
    width: auto;
    font-size: 16px;
    letter-spacing: 1px;
    color: #f5e6b8;
    -unity-text-align: middle-left;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* ============================================================
   TĂNG CỠ CHỮ TOÀN UI (lần 2 — user báo vẫn nhỏ, tăng thêm ~40%)
   Font BoldPixels vẽ ở 16px nên cỡ là BỘI SỐ CỦA 8 sẽ nét nhất (8/16/24/32);
   các cỡ khác vẫn đọc được nhưng hơi nhoè cạnh.
   ============================================================ */

/* ---------- HUD ---------- */
.stat-bar-label { font-size: 16px; }
.hud-slot-count { font-size: 24px; }
.hud-slot-key   { font-size: 16px; }
#hud-ping-label, #hud-fps-label { font-size: 18px; }
#hud-boss-name  { font-size: 24px; letter-spacing: 3px; }
#hud-prompt-text, #hud-revive-text { font-size: 20px; }

/* ---------- TAB: nhân vật / chỉ số / túi đồ ---------- */
.stat-cell-key  { font-size: 16px; }
.stat-cell-val  { font-size: 20px; }
#inv-char-name  { font-size: 32px; }
#inv-char-level { font-size: 20px; }
.inv-tab        { font-size: 20px; }
.detail-btn, .bonfire-btn { font-size: 18px; }
#inv-detail-name { font-size: 24px; }
#inv-detail-desc { font-size: 16px; }
.alloc-name, .alloc-val  { font-size: 18px; }
.inv-cell-count { font-size: 16px; }
#inv-weight-label { font-size: 16px; }

/* ---------- Fast travel / checkpoint ---------- */
#ft-count, #ft-preview-name, #ft-preview-region { font-size: 20px; }
.ft-row { font-size: 18px; }
#ft-points, #ft-flasks-total { font-size: 18px; }

/* ---------- Loading / pause / settings / game over ---------- */
#loading-title  { font-size: 28px; }
#loading-area   { font-size: 24px; }
#loading-status, #loading-tip, #loading-countdown { font-size: 18px; }
#pause-title, #set-title { font-size: 32px; }
#go-title { font-size: 40px; }
#go-subtitle, #go-time, #go-level { font-size: 20px; }
#waiting-title { font-size: 28px; }
#waiting-desc  { font-size: 18px; }

/* Toast lưu game: cỡ chữ set INLINE trong GameUIController.Toast.cs (style.fontSize)
   nên USS không đè được — đã tăng trực tiếp trong C#. */

/* ============================================================
   NỚI KHUNG CHO CHỮ TO (2026-07-28) — user báo chữ tràn khung.
   Sau khi tăng cỡ chữ (~1.5x) mọi container cỡ cố định đều chật. Nới ~20-30%
   theo đúng tỉ lệ chữ đã tăng. ĐẶT CUỐI FILE vì #inv-panel/#pause-content...
   được khai báo nhiều lần ở trên (USS lấy luật SAU cùng độ ưu tiên).
   ============================================================ */

/* ---------- TAB: inventory / nhân vật ---------- */
#inv-panel {
    width: 1240px;              /* 1040 → 1240 */
    height: 780px;              /* 660 → 780 */
    overflow: hidden;
}

#inv-left {
    width: 480px;               /* 400 → 480: chứa tên nhân vật 32px + 2 cột chỉ số 20px */
    padding-left: 24px; padding-right: 24px;
    padding-top: 20px; padding-bottom: 20px;
    flex-shrink: 0;
}

#inv-right {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 24px; padding-right: 24px;
    padding-top: 20px; padding-bottom: 20px;
    overflow: hidden;
}

#inv-detail {
    width: 330px;               /* 240 → 330: tên item 24px + mô tả 16px xuống dòng */
    flex-shrink: 0;
}

/* Ô chỉ số: cao hơn cho chữ 20px, và chừa lề trong rộng hơn. */
.stat-cell {
    width: 48%;
    min-height: 38px;           /* 26 → 38 */
    padding-left: 14px; padding-right: 14px;
    padding-top: 7px; padding-bottom: 7px;
    margin-bottom: 8px;
    align-items: center;
}

/* Tab (Character/Inventory/…): chữ 20px cần nhiều lề ngang hơn. */
.inv-tab {
    padding-left: 22px; padding-right: 22px;
    padding-top: 10px; padding-bottom: 10px;
}

/* Nút: cao hơn để chữ 18px không sát viền. */
.bonfire-btn { height: 60px; }
.detail-btn  { height: 44px; padding-left: 16px; padding-right: 16px; }
.plus-btn    { min-width: 38px; min-height: 38px; }

/* Ô trang bị + ô đồ: nới nhẹ cho số lượng 16px ở góc không đè icon. */
.equip-slot { width: 58px; height: 58px; }
.inv-cell   { width: 58px; height: 58px; }

/* Nhãn số HP/Mana trong Tab: chữ 16px cần chỗ cho "1000/1000". */
.stat-bar-label { width: 96px; }

/* ---------- HUD ---------- */
/* Ô bình/skill: chữ đếm 24px ở góc dưới-phải cần khung to hơn. */
.hud-slot        { width: 72px; height: 72px; }
.hud-slot.skill  { width: 82px; height: 82px; }
.hud-slot-icon   { width: 42px; height: 42px; }

/* ---------- Fast travel (bảng checkpoint) ---------- */
#ft-panel     { height: 420px; }   /* 300 → 420 */
#ft-list-col  { width: 300px; padding-right: 16px; }  /* 220 → 300 */
#ft-preview-col { padding-left: 16px; }
.ft-row { min-height: 40px; padding-left: 14px; padding-right: 14px; }

/* ---------- Overlay: pause / settings / game over / loading / waiting ---------- */
#pause-content   { width: 500px; }   /* 360 → 500 (tiêu đề 32px) */
#set-content     { width: 700px; }   /* 520 → 700 */
#go-content      { width: 640px; }   /* 480 → 640 (go-title 40px) */
#loading-content { width: 720px; }   /* 560 → 720 */
#waiting-content { width: 600px; }   /* 460 → 600 */

/* ============================================================
   COOP — HIỂN THỊ TRẠNG THÁI GỤC / TIẾN TRÌNH CỨU (2026-07-28)

   Trước đây chỉ có `#hud-revive` và nó đọc `_revive` của CHÍNH MÌNH:
     - Người ĐANG GỤC: HUD trống trơn, không biết ai đang cứu mình.
     - Người CÒN SỐNG ở xa: không biết đồng đội đã gục.
   Thêm 2 khối, loại trừ nhau nên không bao giờ chồng lên nhau:
     #hud-downed    — chỉ hiện khi MÌNH gục   (giữa-dưới, trên chỗ prompt [R])
     #hud-ally-down — chỉ hiện khi MÌNH sống mà đồng đội gục NGOÀI tầm cứu (trên-giữa)
   ============================================================ */

/* ---------- MÌNH ĐANG GỤC ---------- */
#hud-downed {
    position: absolute;
    bottom: 250px; left: 50%;
    translate: -50% 0;
    padding-left: 26px; padding-right: 26px;
    padding-top: 12px; padding-bottom: 12px;
    background-color: rgba(8, 10, 16, 0.9);
    border-width: 2px;
    border-color: rgba(150, 40, 40, 0.9);
    border-radius: 0;
    align-items: center;
}

#hud-downed-text {
    color: #ffb0a0;
    font-size: 20px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

#hud-downed-track {
    margin-top: 8px;
    width: 260px;
    height: 22px;
    background-image: url('../Art/UI_Elements/OrnateUI/bar_track.png');
    -unity-slice-left: 9;
    -unity-slice-right: 9;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 4px; padding-right: 4px;
    padding-top: 4px; padding-bottom: 4px;
    overflow: hidden;
}

/* Dải ĐỎ Gandalf: dùng lại dải HP ngang (đã có sẵn cho Tab). */
#hud-downed-fill {
    height: 100%;
    width: 0%;
    background-image: url('../Art/UI_Elements/Bars/fill_hp_strip.png');
    -unity-slice-left: 2;
    -unity-slice-right: 2;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* ---------- ĐỒNG ĐỘI GỤC Ở XA (mình còn sống) ---------- */
#hud-ally-down {
    position: absolute;
    top: 28px; left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding-left: 22px; padding-right: 22px;
    padding-top: 10px; padding-bottom: 10px;
    background-color: rgba(8, 10, 16, 0.9);
    border-width: 2px;
    border-color: rgba(150, 40, 40, 0.9);
    border-radius: 0;
}

#hud-ally-down-text {
    color: #ffb0a0;
    font-size: 20px;
    letter-spacing: 2px;
}

/* Khoảng cách: vàng nhạt cho tách khỏi chữ đỏ, dễ đọc nhanh. */
#hud-ally-down-dist {
    color: #f5e6b8;
    font-size: 20px;
    letter-spacing: 1px;
    margin-left: 14px;
}

/* Prompt [R] cũ: đồng bộ cỡ chữ + thanh với 2 khối trên. */
#hud-revive-text { font-size: 20px; }
#hud-revive-track { width: 260px; height: 22px; }

/* ============================================================
   SỬA LẦN 8 — ESC dễ đọc + panel thông tin item không còn mờ
   User báo: (a) chữ trong ESC nhỏ khó nhìn, (b) thông tin item trong inventory
   khó đọc vì khung TRONG SUỐT làm chữ mờ và chữ nhỏ.
   ĐẶT CUỐI FILE: nhiều selector dưới đây đã khai báo ở trên (kể cả trong khối
   theme Ornate) — USS lấy luật SAU cùng độ ưu tiên.
   ============================================================ */

/* ---------- (a) MÀN ESC (pause) ---------- */
/* #pause-title đã lên 32px ở lần 6, nhưng .pause-btn thì BỊ BỎ SÓT — vẫn 12px.
   Đó mới là phần user đọc nhiều nhất (RESUME / SETTINGS / QUIT TO MENU). */
.pause-btn {
    font-size: 22px;       /* 12 → 22 */
    height: 64px;          /* 46 → 64: chữ 22px cần chỗ, không sát viền */
    letter-spacing: 3px;   /* giảm nhẹ vì chữ to hơn, giữ tổng bề ngang vừa khung */
    margin-bottom: 14px;
}

#pause-title {
    font-size: 40px;       /* 32 → 40 cho cân với nút 22px */
    letter-spacing: 8px;
    margin-bottom: 36px;
}

#pause-content { width: 620px; }   /* 500 → 620: chứa nút chữ 22px + letter-spacing */

/* ---------- (a2) MÀN SETTINGS (mở từ ESC) ---------- */
/* Cùng lỗi: tiêu đề đã to nhưng nhãn/nút bên trong vẫn 11-12px. */
.set-row-key    { font-size: 20px; width: 150px; }   /* 12 → 20 */
.set-row-key.wide { width: 320px; }                  /* 220 → 320 cho chữ 20px */
.set-row-val    { font-size: 20px; width: 72px; }    /* 12 → 20 */
.set-section    { font-size: 18px; letter-spacing: 2px; }  /* 11 → 18 */
.set-row        { margin-bottom: 12px; min-height: 40px; }

.set-btn {
    font-size: 20px;       /* 11 → 20 */
    height: 56px;          /* 40 → 56 */
    letter-spacing: 2px;
    padding-left: 26px; padding-right: 26px;
}

#set-content { width: 900px; }   /* 700 → 900: hàng key(320)+slider+val(72) ở chữ 20px */

/* ---------- (b) PANEL THÔNG TIN ITEM ---------- */
/* NGUYÊN NHÂN chữ mờ: khối theme Ornate ép `background-color: rgba(0,0,0,0)` lên
   #inv-detail, XOÁ MẤT nền đen đặc rgba(6,6,8,0.98) của luật gốc. Art panel_alt.png
   có phần giữa bán trong suốt → cảnh game phía sau lọt qua, chữ chìm vào nền.
   Trả lại nền đục NHƯNG GIỮ khung Ornate (background-image không bị đụng). */
#inv-detail {
    background-color: rgba(8, 7, 12, 0.97);
    width: 400px;              /* 330 → 400 cho chữ to hơn */
    padding: 22px;
}

#inv-detail-name {
    font-size: 28px;           /* 24 → 28 */
    color: #fbf0cf;            /* sáng hơn #e8d8a8 để nổi trên nền đục */
    margin-bottom: 6px;
}

#inv-detail-desc {
    font-size: 19px;           /* 16 → 19 */
    color: rgba(255, 255, 255, 0.88);   /* 0.55 → 0.88: mô tả trước đây mờ nhất */
    margin-bottom: 14px;
}

/* Dòng chỉ số cộng thêm (tạo runtime, class .detail-mod trong
   GameUIController.Inventory.Refresh.cs) — trước 11px, nhỏ nhất cả panel. */
.detail-mod {
    font-size: 19px;
    color: rgb(150, 225, 150);
}

#inv-detail-mods { margin-bottom: 16px; }

.detail-btn { font-size: 20px; height: 50px; letter-spacing: 2px; }

/* ============================================================
   SỬA LẦN 9 — Tab: icon mặt player ở ô giữa + chỉ số dễ đọc
   User báo: (a) ô giữa khi Tab lên trống, muốn có icon mặt player;
             (b) các dòng HP/DEF/RES/AD nhỏ khó nhìn.
   ĐẶT CUỐI FILE để thắng cascade (#inv-avatar/.stat-cell-* khai nhiều lần).
   ============================================================ */

/* ---------- (a) ICON MẶT PLAYER ---------- */
/* #inv-avatar vốn CHỈ có nền tối + viền tròn, KHÔNG có ảnh nào → ô giữa trống.
   (Khác `.hud-avatar` trên HUD — cái đó bị ẩn vì art Gandalf đã có orb chân dung.)
   Ảnh cắt từ đầu nhân vật trong `_Idle.png` (rows 0..13 của sprite 21x38). */
#inv-avatar {
    width: 104px; height: 104px;
    border-radius: 52px;
    background-image: url('../Art/UI_Elements/player_portrait.png');
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgb(20, 15, 26);
    border-width: 2px;
    border-color: rgba(201, 168, 76, 0.75);
}

/* ---------- (b) CHỈ SỐ TRONG TAB ---------- */
/* Ô DEF/RES/AD/AP: 16/20px vẫn hụt so với phần còn lại của Tab sau khi nâng cỡ chữ. */
.stat-cell-key { font-size: 20px; letter-spacing: 1px; color: rgba(255, 255, 255, 0.8); }
.stat-cell-val { font-size: 24px; color: #fbf0cf; }

.stat-cell {
    min-height: 46px;
    padding-left: 14px; padding-right: 14px;
    padding-top: 8px; padding-bottom: 8px;
    margin-bottom: 9px;
}

/* Số "1000/1000" của các thanh HP/Mana/Stamina/EXP trong Tab.
   CHỈ nhắm theo ID của Tab — KHÔNG dùng class `.stat-bar-label` vì class đó dùng chung với HUD
   (hud-hp-label...), mà nhãn HUD đang bị ẩn CÓ CHỦ Ý (khung Gandalf hẹp, đọc máu bằng hình). */
#inv-hp-label,
#inv-mana-label,
#inv-stamina-label,
#inv-exp-label {
    font-size: 20px;
    width: 124px;
    color: #fbf0cf;
}

/* ============================================================
   SỬA LẦN 10 — TAB NHIỆM VỤ (log quest trong bảng Tab)
   User: "hiện log nhiệm vụ đã nhận chưa hoàn thành nằm chung với
   các mục item, skill, accessory lúc tab".

   ⚠ Các class `tracker-*` VỐN CHỈ CÓ trong DialogueUI.uss (quest tracker góc màn hình).
   GameUI.uss là file style RIÊNG → không thừa hưởng gì từ đó, nên phải khai lại ở đây,
   nếu không log nhiệm vụ trong Tab sẽ hiện chữ trần không khung.
   Cỡ chữ để to hơn bản HUD (24/20 thay vì 20/18) cho khớp phần còn lại của Tab.
   ============================================================ */

#inv-quest-scroll { flex-grow: 1; }

#inv-quest-list {
    padding-left: 4px; padding-right: 4px;
    padding-top: 2px;
}

.tracker-entry {
    margin-bottom: 12px;
    padding-left: 14px; padding-right: 14px;
    padding-top: 12px; padding-bottom: 12px;
    background-color: rgba(200, 170, 80, 0.07);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(200, 170, 80, 0.18);
}

.tracker-entry-title {
    font-size: 24px;
    color: #f2e8c8;
    -unity-font-style: bold;
    margin-bottom: 6px;
    white-space: normal;
}

.tracker-entry-progress {
    font-size: 20px;
    color: #c2b898;
    margin-bottom: 6px;
    white-space: normal;
}

.tracker-progress-bar-bg {
    width: 100%;
    height: 14px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
}

.tracker-progress-bar-fill {
    height: 100%;
    background-color: #E8C869;
    border-radius: 2px;
}

/* Xong mục tiêu → viền + chữ xanh, để phân biệt với nhiệm vụ đang làm. */
.tracker-entry-complete { border-color: rgba(100, 200, 100, 0.4); }
.tracker-entry-complete .tracker-entry-title { color: #A8E8A0; }
.tracker-entry-complete .tracker-progress-bar-fill { background-color: #80D880; }

/* ============================================================
   THANH MÁU BOSS TO HƠN (2026-08-03) — user báo khó quan sát.
   ĐẶT CUỐI FILE để thắng cascade (#hud-boss-* đã được set ở 3 chỗ phía trên).
   Track 10px → 26px, bề rộng 600 → 860, tên boss 24 → 32px + khung Ornate cho
   đồng bộ với các thanh khác (HP/Mana/loading đều dùng bar_track.png).
   ============================================================ */
#hud-boss {
    width: 860px;
    bottom: 74px;
}

#hud-boss-name {
    font-size: 32px;
    letter-spacing: 4px;
    margin-bottom: 8px;
}

#hud-boss-track {
    height: 26px;
    background-image: url('../Art/UI_Elements/OrnateUI/bar_track.png');
    -unity-slice-left: 9;
    -unity-slice-right: 9;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding-left: 4px; padding-right: 4px;
    padding-top: 4px; padding-bottom: 4px;
    overflow: hidden;
}

/* Dải đỏ dùng lại sprite HP ngang (giống #hud-downed-fill) thay vì màu phẳng. */
#hud-boss-fill {
    background-image: url('../Art/UI_Elements/Bars/fill_hp_strip.png');
    -unity-slice-left: 2;
    -unity-slice-right: 2;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* ============================================================
   CON TRỎ BÀN PHÍM cho bảng REST (GameUIController.RestNav.cs).
   ĐẶT CUỐI FILE để thắng cascade với .bonfire-btn / .ft-row ở trên.

   Vì sao cần class RIÊNG (không dùng :hover): con trỏ bàn phím không phải chuột, và .ft-row còn dùng
   class `selected` cho "beacon đã chọn để teleport" — hai trạng thái khác nhau, phải phân biệt được.
   ============================================================ */
.kb-selected {
    background-image: url('../Art/UI_Elements/OrnateUI/button_hover.png');
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 7;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: #fff6d8;
    scale: 1.04;
}

/* Ô SỐ bình máu/mana (Label, không phải Button) — không có sprite nút nên tô bằng viền + nền vàng. */
#flask-hp-val.kb-selected,
#flask-mana-val.kb-selected {
    background-image: none;
    background-color: rgba(201, 168, 76, 0.28);
    border-width: 2px;
    border-color: #e8c873;
    border-radius: 4px;
    scale: 1;
}

/* ============================================================
   SỬA LẦN 10 — Chỉ số item bị CẮT khi số lớn (tăng chỉ số trên web)
   User báo: chỉ số cộng ĐÚNG nhưng panel không đủ chỗ chứa số.

   NGUYÊN NHÂN: UI Toolkit mặc định `white-space: nowrap` cho Label. Dòng
   ".detail-mod" (tạo runtime trong GameUIController.Inventory.Refresh.cs) không hề
   khai white-space, nên khi admin nâng amount trên web (StatModifier.amount là int,
   có thể 4-5 chữ số) chuỗi "AttackDamage +12500" dài hơn 400px của #inv-detail và bị
   cắt cứng — không xuống dòng, không ellipsis, không scroll.
   Panel cha (#inv-detail) lại nằm trong #inv-panel có `overflow: hidden` nên phần
   tràn biến mất hẳn thay vì đè ra ngoài.

   ĐẶT CUỐI FILE để thắng cascade — .detail-mod / .stat-cell-val đều khai nhiều lần ở trên.
   ============================================================ */

/* (a) DÒNG CHỈ SỐ ITEM — cho xuống dòng thay vì cắt. */
.detail-mod {
    white-space: normal;
    flex-shrink: 0;             /* không bị bóp khi panel chật */
}

/* Panel item: nới rộng để chuỗi "Stat +số" dài có chỗ, và cao ra theo nội dung.
   KHÔNG đặt max-height: #inv-detail không có overflow riêng, nhưng nó nằm trong #inv-panel
   (overflow: hidden) — chặn chiều cao ở đây chỉ khiến dòng cuối bị cắt lại. Panel cao 780px,
   item nhiều nhất 4 modifier nên chiều cao tự nhiên vẫn nằm trong khung. */
#inv-detail {
    width: 440px;              /* 400 → 440 */
}

/* Khối chứa các dòng chỉ số: để nó CAO RA theo nội dung, đừng bóp.
   KHÔNG dùng `overflow: scroll` — UI Toolkit chỉ nhận visible/hidden cho overflow, muốn cuộn
   phải bọc bằng element ScrollView trong UXML. Đặt max-height rồi hidden sẽ lại CẮT mất số,
   đúng cái bug đang sửa. Item thực tế chỉ có 2-4 modifier nên chiều cao tự nhiên là đủ. */
#inv-detail-mods {
    flex-shrink: 0;
}

/* (b) Ô CHỈ SỐ TRONG TAB (DEF/RES/AD/AP) — số lớn từ web cũng bị bóp ở đây.
   .stat-cell là flex-row chứa key + val; val phải được ưu tiên giữ nguyên bề rộng,
   còn key mới là phần được phép co lại. */
.stat-cell { min-width: 0; }

.stat-cell-key {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.stat-cell-val {
    flex-shrink: 0;            /* KHÔNG bóp con số */
    white-space: nowrap;
    -unity-text-align: middle-right;
    padding-left: 6px;
}
