/* ============================================================
   ATTRITION — IN-GAME UI (HUD, Inventory, Fast Travel, Game Over, Loading)
   Dark-fantasy theme. Gold #c9a84c, ash #07080d.
   ============================================================ */

#game-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
}

.overlay-screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}

.hidden { display: none; }

/* ===================== HUD ===================== */

#hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

#hud-topleft {
    position: absolute;
    left: 24px; top: 20px;
    flex-direction: row;
    align-items: center;
}

.hud-decor-bg {
    position: absolute;
    left: -12px; top: -12px; bottom: -12px; right: -12px;
    background-color: rgba(4, 5, 8, 0.6);
    border-radius: 40px;
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.3);
}

.hud-avatar {
    width: 56px; height: 56px;
    border-radius: 28px;
    background-color: rgb(30, 21, 48);
    border-width: 2px;
    border-color: rgba(201, 168, 76, 0.55);
    margin-right: 12px;
}

#hud-bars { width: 240px; }

.stat-bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.stat-bar-track {
    flex-grow: 1;
    height: 12px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.8);
    border-radius: 2px;
    overflow: hidden;
}

.stat-bar-fill {
    height: 100%;
    width: 100%;
    border-radius: 1px;
}

.fill-hp { background-color: rgb(200, 48, 48); } /* Brighter red */
.fill-mana { background-color: rgb(48, 110, 200); } /* Brighter blue */
.fill-stamina { background-color: rgb(200, 160, 64); } /* Brighter yellow */
.fill-exp { background-color: rgb(140, 82, 255); } /* Purple for EXP */

.stat-bar-label {
    width: 64px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 10px;
    -unity-text-align: middle-right;
    margin-left: 6px;
}

.hud-lvl {
    width: auto;
    -unity-text-align: middle-left;
    color: #ebdcb1;
    margin-top: 4px;
    font-size: 12px;
    letter-spacing: 2px;
    text-shadow: 0 0 6px rgba(201, 168, 76, 0.5);
}

/* --- Bottom bar: flasks + skill --- */
#hud-bottomleft {
    position: absolute;
    left: 24px; bottom: 22px;
    flex-direction: row;
    align-items: flex-end;
}

.hud-decor-bg-small {
    position: absolute;
    left: -8px; top: -8px; bottom: -8px; right: -8px;
    background-color: rgba(4, 5, 8, 0.6);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.3);
}

.hud-slot {
    width: 56px; height: 56px;
    border-radius: 6px;
    background-color: rgba(8, 10, 16, 0.85);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.35);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
}

.hud-slot.skill {
    width: 64px; height: 64px;
    border-color: rgba(201, 168, 76, 0.6);
}

.hud-slot-icon {
    width: 32px; height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-slot-count {
    position: absolute;
    right: 3px; bottom: 1px;
    color: #e8d8a8;
    font-size: 13px;
    -unity-text-align: lower-right;
}

.hud-slot-key {
    position: absolute;
    left: 3px; top: 1px;
    color: rgba(255, 255, 255, 0.45);
    font-size: 9px;
}

.hud-slot-empty { opacity: 0.4; }

/* --- Boss bar (top center) --- */
#hud-boss {
    position: absolute;
    top: 24px; left: 50%;
    translate: -50% 0;
    width: 520px;
    align-items: center;
}

#hud-boss-name {
    color: #e8d8a8;
    font-size: 14px;
    letter-spacing: 4px;
    margin-bottom: 4px;
    text-shadow: 0 2px 6px rgba(0,0,0,0.9);
}

#hud-boss-track {
    width: 100%;
    height: 10px;
    background-color: rgba(0,0,0,0.7);
    border-width: 1px;
    border-color: rgba(120, 30, 30, 0.8);
    overflow: hidden;
}

#hud-boss-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(150, 32, 32);
}

/* --- Interaction prompt (Rest, pickup) --- */
#hud-prompt {
    position: absolute;
    bottom: 120px; left: 50%;
    translate: -50% 0;
    padding: 6px 16px;
    background-color: rgba(8, 10, 16, 0.85);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.4);
    border-radius: 4px;
}

#hud-prompt-text {
    color: #e8d8a8;
    font-size: 12px;
    letter-spacing: 2px;
}

/* ===================== CHARACTER / INVENTORY ===================== */
#inv-dim {
    background-color: rgba(4, 3, 10, 0.82);
}

#inv-panel {
    flex-direction: row;
    width: 920px;
    height: 560px;
    background-color: rgba(6, 6, 8, 0.98); /* Deep obsidian */
    border-width: 2px;
    border-color: rgba(180, 140, 50, 0.6); /* Gold rim */
    border-radius: 16px;
    overflow: hidden;
}

/* Ornate decorative divider */
.fancy-divider {
    height: 2px;
    width: 100%;
    background-color: rgba(201, 168, 76, 0.35);
    margin: 8px 0;
    border-radius: 1px;
}

.ornate-header {
    align-items: center;
    margin-bottom: 6px;
}

/* Left: character + equip */
#inv-left {
    width: 340px;
    padding: 22px;
    border-right-width: 1px;
    border-right-color: rgba(201, 168, 76, 0.12);
    align-items: center;
}

#inv-char-name {
    color: #e8d8a8; /* Parchment */
    font-size: 20px;
    letter-spacing: 6px;
    margin-bottom: 2px;
    text-shadow: 0 4px 10px rgba(201, 168, 76, 0.4);
}

#inv-char-level {
    color: rgba(201, 168, 76, 0.8);
    font-size: 11px;
    letter-spacing: 4px;
    margin-bottom: 10px;
}

#inv-equip-row {
    flex-direction: row;
    justify-content: center;
}

.equip-col { align-items: center; }

.equip-slot {
    width: 52px; height: 52px;
    border-radius: 8px;
    background-color: rgba(2, 2, 3, 0.8);
    border-top-width: 1px;
    border-left-width: 1px;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-top-color: rgba(20, 20, 20, 0.9);
    border-left-color: rgba(20, 20, 20, 0.9);
    border-bottom-color: rgba(201, 168, 76, 0.4);
    border-right-color: rgba(201, 168, 76, 0.4);
    align-items: center;
    justify-content: center;
    margin: 6px;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.2s;
}

.equip-slot:hover { 
    border-top-color: rgba(201, 168, 76, 0.9); 
    border-left-color: rgba(201, 168, 76, 0.9); 
    background-color: rgba(201, 168, 76, 0.15);
    scale: 1.08;
}
.equip-slot.skill { border-bottom-color: rgba(201, 168, 76, 0.7); border-right-color: rgba(201, 168, 76, 0.7); }

.equip-slot-icon {
    width: 36px; height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

#inv-avatar {
    width: 96px; height: 96px;
    border-radius: 48px;
    background-color: rgb(16, 12, 22);
    border-width: 2px;
    border-color: rgba(201, 168, 76, 0.6);
    margin: 4px;
}

/* stat grid */
#inv-stats {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
    margin-top: 16px;
}

.stat-cell {
    width: 47%;
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 10px;
    margin-bottom: 6px;
    background-color: rgba(0,0,0,0.6);
    border-radius: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 168, 76, 0.2);
}

.stat-cell-key { color: rgba(255,255,255,0.55); font-size: 11px; letter-spacing: 1px; }
.stat-cell-val { color: #e8d8a8; font-size: 12px; }

/* stat allocation (Option 2: 5 free points/level) */
#inv-points {
    color: #c9a84c;
    font-size: 11px;
    letter-spacing: 2px;
    margin-top: 12px;
    margin-bottom: 4px;
}

.alloc-btn {
    width: 20px; height: 20px;
    border-radius: 3px;
    background-color: rgba(201, 168, 76, 0.18);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.45);
    color: #e8d8a8;
    font-size: 13px;
    -unity-text-align: middle-center;
    margin-left: 6px;
    padding: 0;
}

.alloc-btn:hover { background-color: rgba(201, 168, 76, 0.32); }
.alloc-btn:disabled { opacity: 0.25; }

/* Right: inventory grid */
#inv-right {
    flex-grow: 1;
    padding: 22px;
}

#inv-tabs {
    flex-direction: row;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255,255,255,0.07);
}

.inv-tab {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    color: rgba(255,255,255,0.4);
    font-size: 12px;
    letter-spacing: 3px;
    padding: 6px 16px;
}

.inv-tab:hover { color: rgba(255,255,255,0.7); }
.inv-tab.active { color: #e8d8a8; border-bottom-color: #c9a84c; }

#inv-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    align-content: flex-start;
}

.inv-cell {
    width: 52px; height: 52px;
    margin: 4px;
    border-radius: 6px;
    background-color: rgba(4, 5, 8, 0.85);
    border-top-width: 1px;
    border-left-width: 1px;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-top-color: rgba(10, 10, 10, 0.9);
    border-left-color: rgba(10, 10, 10, 0.9);
    border-bottom-color: rgba(201, 168, 76, 0.3);
    border-right-color: rgba(201, 168, 76, 0.3);
    align-items: center;
    justify-content: center;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.15s;
}

.inv-cell:hover { 
    border-top-color: rgba(201, 168, 76, 0.85); 
    border-left-color: rgba(201, 168, 76, 0.85); 
    background-color: rgba(201, 168, 76, 0.2);
    scale: 1.05;
}
.inv-cell.selected { border-top-color: #e8c873; border-left-color: #e8c873; background-color: rgba(201,168,76,0.3); }

.inv-cell-icon {
    width: 38px; height: 38px;
    -unity-background-scale-mode: scale-to-fit;
}

.inv-cell-count {
    position: absolute;
    right: 3px; bottom: 1px;
    color: #ffffff;
    font-size: 11px;
}

#inv-weight-row {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

#inv-weight-track {
    flex-grow: 1;
    height: 6px;
    background-color: rgba(0,0,0,0.5);
    border-radius: 3px;
    overflow: hidden;
    margin-right: 8px;
}

#inv-weight-fill {
    height: 100%;
    background-color: rgba(201, 168, 76, 0.6);
}

#inv-weight-label { color: rgba(255,255,255,0.45); font-size: 10px; }

/* item detail popup */
#inv-detail {
    position: absolute;
    right: 20px; top: 60px;
    width: 240px;
    padding: 18px;
    background-color: rgba(6, 6, 8, 0.98);
    border-width: 2px;
    border-color: rgba(180, 140, 50, 0.6);
    border-radius: 8px;
}

#inv-detail-name {
    color: #e8d8a8;
    font-size: 16px;
    letter-spacing: 2px;
    margin-bottom: 2px;
    white-space: normal;
    text-shadow: 0 2px 8px rgba(201, 168, 76, 0.5);
}

#inv-detail-desc {
    color: rgba(255,255,255,0.55);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 10px;
}

#inv-detail-mods { margin-bottom: 12px; }

.detail-mod { color: rgb(120, 200, 120); font-size: 11px; }

.detail-btn {
    height: 30px;
    border-radius: 4px;
    background-color: rgba(201, 168, 76, 0.18);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.45);
    color: #e8d8a8;
    font-size: 11px;
    letter-spacing: 2px;
    margin-top: 6px;
}

.detail-btn:hover { background-color: rgba(201, 168, 76, 0.3); }
.detail-btn.drop { border-color: rgba(180,60,60,0.5); color: rgba(220,120,120,0.9); background-color: rgba(180,40,40,0.12); }

/* ===================== BONFIRE / CHECKPOINT ===================== */
#ft-dim { background-color: rgba(4, 3, 10, 0.85); }

.bonfire-menu {
    width: 280px;
    align-items: center;
    background-color: transparent;
}

.bonfire-title {
    color: #ebdcb1;
    font-size: 28px;
    letter-spacing: 6px;
    margin-bottom: 8px;
    text-shadow: 0 0 10px rgba(201, 168, 76, 0.6);
}

.bonfire-btn {
    width: 100%;
    height: 48px;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 1px;
    border-color: rgba(201, 168, 76, 0.2);
    color: #d1c9c0;
    font-size: 16px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    transition-property: color, scale, background-color;
    transition-duration: 0.2s;
}

.bonfire-btn:hover {
    color: #ebdcb1;
    background-color: rgba(201, 168, 76, 0.15);
    scale: 1.05;
}

.bonfire-btn.half { width: 48%; margin: 0 1%; }

.bonfire-popup {
    width: 420px;
    background-color: rgba(6, 6, 8, 0.98);
    border-width: 2px;
    border-color: rgba(180, 140, 50, 0.6);
    border-radius: 12px;
    padding: 24px;
    align-items: center;
}

.popup-title {
    color: #ebdcb1;
    font-size: 20px;
    letter-spacing: 4px;
    margin-bottom: 8px;
    text-shadow: 0 0 8px rgba(201, 168, 76, 0.4);
}

.unspent-label {
    color: #c9a84c;
    font-size: 14px;
    letter-spacing: 2px;
    margin: 12px 0;
}

.alloc-list { width: 100%; margin-bottom: 16px; }

.alloc-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 36px;
    border-bottom-width: 1px;
    border-color: rgba(255,255,255,0.05);
}

.alloc-name { color: #d1c9c0; font-size: 12px; letter-spacing: 1px; width: 120px; }
.alloc-val { color: #ebdcb1; font-size: 14px; flex-grow: 1; -unity-text-align: middle-right; margin-right: 16px; }

.plus-btn {
    width: 32px; height: 28px;
    background-color: rgba(201, 168, 76, 0.2);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.5);
    color: #ebdcb1;
    border-radius: 4px;
    font-size: 16px;
}
.plus-btn:hover { background-color: rgba(201, 168, 76, 0.4); }

.flask-alloc-container {
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    margin-bottom: 24px;
    margin-top: 12px;
}

.flask-col { align-items: center; }

.flask-name {
    color: #d1c9c0;
    font-size: 12px;
    letter-spacing: 1px;
    margin-top: 12px;
    margin-bottom: 8px;
}

.flask-stepper {
    flex-direction: row;
    align-items: center;
}

.stepper-btn {
    width: 32px; height: 32px;
    background-color: rgba(201, 168, 76, 0.2);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.5);
    color: #ebdcb1;
    border-radius: 4px;
    font-size: 14px;
}
.stepper-btn:hover { background-color: rgba(201, 168, 76, 0.4); }

.stepper-val {
    color: #ebdcb1;
    font-size: 20px;
    width: 48px;
    -unity-text-align: middle-center;
}

.popup-actions {
    flex-direction: row;
    width: 100%;
    justify-content: center;
    margin-top: 12px;
}

#ft-panel {
    flex-direction: row;
    width: 100%;
    height: 300px;
}

#ft-list-col { width: 220px; padding-right: 12px; border-right-width: 1px; border-color: rgba(201, 168, 76, 0.2); }
#ft-preview-col { flex-grow: 1; padding-left: 12px; justify-content: space-between; }
#ft-count { color: #c9a84c; font-size: 10px; letter-spacing: 2px; margin-bottom: 8px; }

#ft-preview {
    flex-grow: 1;
    background-color: rgba(0,0,0,0.3);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

#ft-preview-name { color: #ebdcb1; font-size: 18px; letter-spacing: 3px; }
#ft-preview-region { color: rgba(255,255,255,0.4); font-size: 11px; }

.ft-btn.go {
    background-color: rgba(201, 168, 76, 0.2);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.5);
    color: #ebdcb1;
    height: 40px;
    border-radius: 4px;
}
.ft-btn.go:hover { background-color: rgba(201, 168, 76, 0.4); }

.ft-item {
    padding: 8px;
    border-bottom-width: 1px;
    border-color: rgba(255,255,255,0.05);
    color: #d1c9c0;
    background-color: transparent;
}
.ft-item:hover { background-color: rgba(255,255,255,0.05); }
.ft-item.selected { color: #ebdcb1; background-color: rgba(201, 168, 76, 0.2); }

/* ===================== GAME OVER ===================== */
#go-dim { background-color: rgba(8, 2, 2, 0.9); }

#go-content { align-items: center; width: 480px; }

#go-sigil {
    width: 64px; height: 64px;
    border-radius: 32px;
    border-width: 2px;
    border-color: rgba(180, 40, 40, 0.6);
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
}

#go-sigil-icon { color: rgb(200, 60, 60); font-size: 30px; }

#go-title {
    color: rgb(200, 56, 56);
    font-size: 40px;
    letter-spacing: 8px;
    -unity-text-align: middle-center;
    text-shadow: 0 4px 16px rgba(0,0,0,0.9);
    margin-bottom: 6px;
}

#go-subtitle {
    color: rgba(255,255,255,0.5);
    font-size: 13px;
    letter-spacing: 3px;
    margin-bottom: 24px;
}

#go-stats {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 28px;
}

.go-stat { align-items: center; margin: 0 22px; }
.go-stat-val { color: #e8d8a8; font-size: 22px; }
.go-stat-key { color: rgba(255,255,255,0.4); font-size: 10px; letter-spacing: 2px; }

#go-actions { flex-direction: row; }

.go-btn {
    height: 44px;
    padding: 0 26px;
    margin: 0 8px;
    border-radius: 5px;
    font-size: 12px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.go-btn.resume {
    background-color: rgba(201, 168, 76, 0.2);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.5);
    color: #e8d8a8;
}

.go-btn.resume:hover { background-color: rgba(201, 168, 76, 0.32); }

.go-btn.quit {
    background-color: rgba(0,0,0,0.5);
    border-width: 1px;
    border-color: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.5);
}

/* ===================== LOADING ===================== */
#loading { background-color: #07080d; }

#loading-content { align-items: center; width: 560px; }

#loading-title {
    color: #ffffff;
    font-size: 30px;
    letter-spacing: 10px;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
    text-shadow: 0 4px 16px rgba(0,0,0,0.9);
}

#loading-area {
    color: #c9a84c;
    font-size: 13px;
    letter-spacing: 4px;
    margin-bottom: 32px;
}

#loading-track {
    width: 100%;
    height: 6px;
    background-color: rgba(255,255,255,0.08);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 10px;
}

#loading-fill {
    height: 100%;
    width: 0;
    background-color: #c9a84c;
}

#loading-status {
    color: rgba(255,255,255,0.45);
    font-size: 11px;
    letter-spacing: 2px;
    margin-bottom: 28px;
}

#loading-tip {
    color: rgba(255,255,255,0.3);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 480px;
}

/* reconnect (coop) variant reuses loading; countdown emphasis */
#loading-countdown {
    color: rgb(200, 120, 60);
    font-size: 13px;
    letter-spacing: 2px;
    margin-top: 6px;
}

/* ===================== PAUSE (ESC) ===================== */
#pause-dim { background-color: rgba(4, 3, 10, 0.88); }

#pause-content { align-items: center; width: 360px; }

#pause-title {
    color: #e8d8a8;
    font-size: 30px;
    letter-spacing: 10px;
    -unity-text-align: middle-center;
    text-shadow: 0 4px 16px rgba(0,0,0,0.9);
    margin-bottom: 32px;
}

#pause-actions { width: 100%; align-items: center; }

.pause-btn {
    width: 100%;
    height: 46px;
    margin-bottom: 12px;
    border-radius: 5px;
    font-size: 12px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    background-color: rgba(0,0,0,0.5);
    border-width: 1px;
    border-color: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.6);
}

.pause-btn:hover {
    border-color: rgba(201, 168, 76, 0.5);
    color: #e8d8a8;
}

.pause-btn.resume {
    background-color: rgba(201, 168, 76, 0.2);
    border-color: rgba(201, 168, 76, 0.5);
    color: #e8d8a8;
}

.pause-btn.resume:hover { background-color: rgba(201, 168, 76, 0.32); }

.pause-btn.quit:hover {
    border-color: rgba(180, 60, 60, 0.6);
    color: rgb(220, 130, 130);
}

/* ===================== SETTINGS (in-game) ===================== */
#set-dim { background-color: rgba(4, 3, 10, 0.9); }

#set-content {
    width: 520px;
    max-height: 88%;
    padding: 28px 32px;
    background-color: rgba(8, 10, 16, 0.97);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.25);
    border-radius: 10px;
}

#set-title {
    color: #e8d8a8;
    font-size: 22px;
    letter-spacing: 8px;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.set-section {
    color: #c9a84c;
    font-size: 11px;
    letter-spacing: 3px;
    margin-top: 14px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 168, 76, 0.15);
    padding-bottom: 4px;
}

.set-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.set-row-key {
    width: 90px;
    color: rgba(255,255,255,0.65);
    font-size: 12px;
}

.set-row-key.wide {
    width: 220px;
    flex-grow: 1;
}

.set-slider { flex-grow: 1; }

.set-row-val {
    width: 46px;
    color: #e8d8a8;
    font-size: 12px;
    -unity-text-align: middle-right;
}

#set-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 22px;
}

.set-btn {
    height: 40px;
    padding: 0 22px;
    margin-left: 10px;
    border-radius: 5px;
    font-size: 11px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    background-color: rgba(0,0,0,0.5);
    border-width: 1px;
    border-color: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.55);
}

.set-btn:hover { border-color: rgba(201,168,76,0.5); color: #e8d8a8; }

.set-btn.primary {
    background-color: rgba(201, 168, 76, 0.2);
    border-color: rgba(201, 168, 76, 0.5);
    color: #e8d8a8;
}

.set-btn.primary:hover { background-color: rgba(201, 168, 76, 0.32); }

/* ============================================================
   VISUAL POLISH OVERRIDES (in-game) — chỉ style, không đổi tên/logic
   ============================================================ */

/* Nền overlay sâu hơn cho pause/settings/inventory */
#pause-dim, #set-dim, #inv-dim {
    background-color: rgba(3, 2, 8, 0.78);
}

/* Pause title + content */
#pause-title {
    color: #fbf4e0;
    letter-spacing: 8px;
    text-shadow: 0 4px 18px rgba(201, 168, 76, 0.3);
}

.pause-btn {
    border-radius: 6px;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.18s;
}
.pause-btn:hover { scale: 1.04; }
.pause-btn.resume {
    border-color: rgba(201, 168, 76, 0.55);
}
.pause-btn.quit:hover {
    color: #ff9b8a;
}

/* Settings panel: kính tối + viền vàng */
#set-content {
    background-color: rgba(10, 9, 16, 0.97);
    border-width: 1px;
    border-color: rgba(201, 168, 76, 0.3);
    border-radius: 12px;
}
#set-title {
    color: #fbf4e0;
    letter-spacing: 6px;
}
.set-section {
    color: #c9a84c;
}

/* HUD bars: bo góc + viền tinh tế cho nổi khối */
.stat-bar-track {
    border-radius: 4px;
}
.stat-bar-fill {
    border-radius: 3px;
}

/* Boss bar nổi bật hơn */
#hud-boss-name {
    color: #f3d9a0;
    text-shadow: 0 2px 10px rgba(150, 30, 30, 0.7);
}

/* Inventory panel viền vàng ấm + bo góc lớn */
#inv-panel {
    border-color: rgba(201, 168, 76, 0.32);
    border-radius: 12px;
}
.inv-tab.active {
    color: #f3e6bd;
}
.inv-cell.selected {
    border-color: #e8c873;
}

/* ============================================================
   WAITING FOR PLAYER (coop — client mất kết nối)
   ============================================================ */
#waiting-dim {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(3, 2, 8, 0.85);
}
#waiting-content {
    align-items: center;
    width: 460px;
}
#waiting-title {
    color: #fbf4e0;
    font-size: 26px;
    letter-spacing: 6px;
    text-shadow: 0 4px 18px rgba(201, 168, 76, 0.3);
    margin-bottom: 12px;
}
#waiting-desc {
    color: rgba(255,255,255,0.5);
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}
#waiting-spinner {
    width: 36px;
    height: 36px;
    border-width: 3px;
    border-color: rgba(201, 168, 76, 0.25);
    border-top-color: #c9a84c;
    border-radius: 18px;
}
