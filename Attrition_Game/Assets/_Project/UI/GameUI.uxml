<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="GameUI.uss"/>
    <ui:VisualElement name="game-root" picking-mode="Ignore">

        <!-- ==================== HUD ==================== -->
        <ui:VisualElement name="hud" picking-mode="Ignore">
            <!-- Top-left: avatar + HP/Mana/Stamina -->
            <ui:VisualElement name="hud-topleft">
                <!-- HUD Dark Fantasy Decor (Viền/bóng) -->
                <ui:VisualElement class="hud-decor-bg"/>
                <ui:VisualElement class="hud-avatar"/>
                <ui:VisualElement name="hud-bars">
                    <ui:VisualElement name="hud-hp-row" class="stat-bar-row">
                        <ui:VisualElement name="hud-hp-track" class="stat-bar-track">
                            <ui:VisualElement name="hud-hp-fill" class="stat-bar-fill fill-hp"/>
                        </ui:VisualElement>
                        <ui:Label name="hud-hp-label" text="100/100" class="stat-bar-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="hud-mana-row" class="stat-bar-row">
                        <ui:VisualElement name="hud-mana-track" class="stat-bar-track">
                            <ui:VisualElement name="hud-mana-fill" class="stat-bar-fill fill-mana"/>
                        </ui:VisualElement>
                        <ui:Label name="hud-mana-label" text="100/100" class="stat-bar-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="hud-stamina-row" class="stat-bar-row">
                        <ui:VisualElement name="hud-stamina-track" class="stat-bar-track">
                            <ui:VisualElement name="hud-stamina-fill" class="stat-bar-fill fill-stamina"/>
                        </ui:VisualElement>
                        <ui:Label name="hud-stamina-label" text="100/100" class="stat-bar-label"/>
                    </ui:VisualElement>
                    <!-- EXP: khung Gandalf chỉ có 2 rãnh (mana/stamina) nên EXP là thanh riêng
                         đặt NGAY DƯỚI khung, cùng cụm để dễ theo dõi (yêu cầu user). -->
                    <ui:VisualElement name="hud-exp-row" class="stat-bar-row">
                        <ui:VisualElement name="hud-exp-track" class="stat-bar-track">
                            <ui:VisualElement name="hud-exp-fill" class="stat-bar-fill fill-exp"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="hud-level" text="LV. 1" class="stat-bar-label hud-lvl"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Coop ping (top-right): độ trễ mạng tới peer, chỉ hiện khi chơi coop -->
            <ui:VisualElement name="hud-ping" class="hidden">
                <ui:VisualElement name="hud-ping-dot"/>
                <ui:Label name="hud-ping-label" text="-- ms"/>
            </ui:VisualElement>
            <!-- FPS (top-right, dưới ping): khung hình/giây để chẩn giật. Luôn hiện. -->
            <ui:VisualElement name="hud-fps">
                <ui:Label name="hud-fps-label" text="-- FPS"/>
            </ui:VisualElement>

            <!-- Boss bar -->
            <ui:VisualElement name="hud-boss" class="hidden">
                <ui:Label name="hud-boss-name" text="LORD CINDER"/>
                <ui:VisualElement name="hud-boss-track">
                    <ui:VisualElement name="hud-boss-fill"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Bottom-left: flasks + skill -->
            <ui:VisualElement name="hud-bottomleft">
                <ui:VisualElement class="hud-decor-bg-small"/>
                <ui:VisualElement name="hud-hp-flask" class="hud-slot">
                    <ui:VisualElement name="hud-hp-flask-icon" class="hud-slot-icon"/>
                    <ui:Label text="Q" class="hud-slot-key"/>
                    <ui:Label name="hud-hp-flask-count" text="3" class="hud-slot-count"/>
                </ui:VisualElement>
                <ui:VisualElement name="hud-skill" class="hud-slot skill">
                    <ui:VisualElement name="hud-skill-icon" class="hud-slot-icon"/>
                    <ui:Label text="K" class="hud-slot-key"/>
                </ui:VisualElement>
                <ui:VisualElement name="hud-mana-flask" class="hud-slot">
                    <ui:VisualElement name="hud-mana-flask-icon" class="hud-slot-icon"/>
                    <ui:Label text="E" class="hud-slot-key"/>
                    <ui:Label name="hud-mana-flask-count" text="3" class="hud-slot-count"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Interaction prompt -->
            <ui:VisualElement name="hud-prompt" class="hidden">
                <ui:Label name="hud-prompt-text" text="[F] CHECKPOINT"/>
            </ui:VisualElement>

            <!-- Coop revive prompt: hiện khi đứng gần đồng đội đã gục (giữ R để hồi sinh) -->
            <ui:VisualElement name="hud-revive" class="hidden">
                <ui:Label name="hud-revive-text" text="[R] HỒI SINH ĐỒNG ĐỘI"/>
                <ui:VisualElement name="hud-revive-track">
                    <ui:VisualElement name="hud-revive-fill"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- COOP — NGƯỜI ĐANG GỤC thấy: có ai đang cứu mình không + tiến trình.
                 Trước đây HUD người gục trống trơn nên không biết đồng đội có đang cứu hay không. -->
            <ui:VisualElement name="hud-downed" class="hidden">
                <ui:Label name="hud-downed-text" text="ĐÃ GỤC — CHỜ ĐỒNG ĐỘI CỨU"/>
                <ui:VisualElement name="hud-downed-track">
                    <ui:VisualElement name="hud-downed-fill"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- COOP — NGƯỜI CÒN SỐNG thấy: đồng đội đã gục (kể cả ở xa, ngoài tầm cứu).
                 Kèm khoảng cách để biết phải chạy tới đâu. -->
            <ui:VisualElement name="hud-ally-down" class="hidden">
                <ui:Label name="hud-ally-down-text" text="ĐỒNG ĐỘI ĐÃ GỤC"/>
                <ui:Label name="hud-ally-down-dist" text="-- m"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ==================== CHARACTER / INVENTORY ==================== -->
        <ui:VisualElement name="inv-screen" class="overlay-screen hidden">
            <ui:VisualElement name="inv-dim" class="overlay-screen"/>
            <ui:VisualElement name="inv-panel">
                <!-- LEFT: character + equipment -->
                <ui:VisualElement name="inv-left">
                    <ui:VisualElement class="ornate-header">
                        <ui:Label name="inv-char-name" text="Wanderer"/>
                        <ui:Label name="inv-char-level" text="LEVEL 1"/>
                    </ui:VisualElement>
                    
                    <ui:VisualElement class="fancy-divider"/>

                    <ui:VisualElement name="inv-equip-row">
                        <ui:VisualElement class="equip-col">
                            <ui:Button name="equip-head" class="equip-slot"><ui:VisualElement name="equip-head-icon" class="equip-slot-icon"/></ui:Button>
                            <ui:Button name="equip-chest" class="equip-slot"><ui:VisualElement name="equip-chest-icon" class="equip-slot-icon"/></ui:Button>
                            <ui:Button name="equip-legs" class="equip-slot"><ui:VisualElement name="equip-legs-icon" class="equip-slot-icon"/></ui:Button>
                            <ui:Button name="equip-boots" class="equip-slot"><ui:VisualElement name="equip-boots-icon" class="equip-slot-icon"/></ui:Button>
                        </ui:VisualElement>
                        <ui:VisualElement class="equip-col" style="justify-content: center;">
                            <ui:VisualElement name="inv-avatar"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="equip-col">
                            <ui:Button name="equip-accessory" class="equip-slot"><ui:VisualElement name="equip-accessory-icon" class="equip-slot-icon"/></ui:Button>
                            <ui:Button name="equip-skill" class="equip-slot skill"><ui:VisualElement name="equip-skill-icon" class="equip-slot-icon"/></ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="fancy-divider" style="margin-top: 10px;"/>

                    <ui:VisualElement name="inv-stats">
                        <ui:VisualElement class="stat-cell"><ui:Label text="DEF" class="stat-cell-key"/><ui:Label name="stat-def" text="10" class="stat-cell-val"/></ui:VisualElement>
                        <ui:VisualElement class="stat-cell"><ui:Label text="RES" class="stat-cell-key"/><ui:Label name="stat-res" text="10" class="stat-cell-val"/></ui:VisualElement>
                        <ui:VisualElement class="stat-cell"><ui:Label text="AD" class="stat-cell-key"/><ui:Label name="stat-ad" text="10" class="stat-cell-val"/></ui:VisualElement>
                        <ui:VisualElement class="stat-cell"><ui:Label text="AP" class="stat-cell-key"/><ui:Label name="stat-ap" text="10" class="stat-cell-val"/></ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="inv-bars" style="margin-top: 10px; width: 80%; align-self: center;">
                        <ui:VisualElement class="stat-bar-row">
                            <ui:VisualElement class="stat-bar-track">
                                <ui:VisualElement name="inv-hp-fill" class="stat-bar-fill fill-hp"/>
                            </ui:VisualElement>
                            <ui:Label name="inv-hp-label" text="100/100" class="stat-bar-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-bar-row">
                            <ui:VisualElement class="stat-bar-track">
                                <ui:VisualElement name="inv-mana-fill" class="stat-bar-fill fill-mana"/>
                            </ui:VisualElement>
                            <ui:Label name="inv-mana-label" text="100/100" class="stat-bar-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-bar-row">
                            <ui:VisualElement class="stat-bar-track">
                                <ui:VisualElement name="inv-stamina-fill" class="stat-bar-fill fill-stamina"/>
                            </ui:VisualElement>
                            <ui:Label name="inv-stamina-label" text="100/100" class="stat-bar-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-bar-row">
                            <ui:VisualElement class="stat-bar-track">
                                <ui:VisualElement name="inv-exp-fill" class="stat-bar-fill fill-exp"/>
                            </ui:VisualElement>
                            <ui:Label name="inv-exp-label" text="EXP 0/100" class="stat-bar-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- RIGHT: inventory grid -->
                <ui:VisualElement name="inv-right">
                    <ui:VisualElement name="inv-tabs">
                        <ui:Button name="inv-tab-equipment" text="EQUIPMENT" class="inv-tab active"/>
                        <ui:Button name="inv-tab-accessory" text="ACCESSORY" class="inv-tab"/>
                        <ui:Button name="inv-tab-skill" text="SKILL" class="inv-tab"/>
                        <ui:Button name="inv-tab-quest" text="QUEST" class="inv-tab"/>
                    </ui:VisualElement>

                    <ui:VisualElement class="fancy-divider" style="margin-top: -14px; margin-bottom: 10px; opacity: 0.5;"/>

                    <ui:ScrollView name="inv-grid-scroll" style="flex-grow: 1;">
                        <ui:VisualElement name="inv-grid"/>
                    </ui:ScrollView>

                    <!-- Log nhiệm vụ: dùng CHUNG vùng với lưới đồ, ẩn/hiện theo tab đang chọn -->
                    <ui:ScrollView name="inv-quest-scroll" class="hidden" style="flex-grow: 1;">
                        <ui:VisualElement name="inv-quest-list"/>
                    </ui:ScrollView>
                    <ui:VisualElement name="inv-weight-row">
                        <ui:Label text="SLOTS" class="inv-tab" style="padding: 0; border-bottom-width: 0;"/>
                        <ui:VisualElement name="inv-weight-track"><ui:VisualElement name="inv-weight-fill"/></ui:VisualElement>
                        <ui:Label name="inv-weight-label" text="0/40"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Detail popup -->
                <ui:VisualElement name="inv-detail" class="hidden">
                    <ui:Label name="inv-detail-name" text="Item"/>
                    <ui:VisualElement class="fancy-divider" style="margin-bottom: 8px;"/>
                    <ui:Label name="inv-detail-desc" text=""/>
                    <ui:VisualElement name="inv-detail-mods"/>
                    <ui:Button name="inv-detail-equip" text="EQUIP" class="detail-btn"/>
                    <ui:Button name="inv-detail-drop" text="DROP" class="detail-btn drop"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ==================== BONFIRE / CHECKPOINT ==================== -->
        <ui:VisualElement name="ft-screen" class="overlay-screen hidden">
            <ui:VisualElement name="ft-dim" class="overlay-screen"/>
            
            <!-- Main Vertical Menu -->
            <ui:VisualElement name="ft-main-menu" class="bonfire-menu">
                <ui:Label text="REST" class="bonfire-title"/>
                <ui:VisualElement class="fancy-divider" style="width: 80%;"/>
                <ui:Button name="ft-btn-rest" text="REST" class="bonfire-btn"/>
                <ui:Button name="ft-btn-levelup" text="LEVEL UP" class="bonfire-btn"/>
                <ui:Button name="ft-btn-flasks" text="FLASKS" class="bonfire-btn"/>
                <ui:Button name="ft-btn-travel" text="FAST TRAVEL" class="bonfire-btn"/>
                <ui:Button name="ft-btn-leave" text="LEAVE" class="bonfire-btn"/>
            </ui:VisualElement>

            <!-- Level Up Popup -->
            <ui:VisualElement name="ft-levelup-menu" class="bonfire-popup hidden">
                <ui:Label text="LEVEL UP" class="popup-title"/>
                <ui:VisualElement class="fancy-divider"/>
                <ui:Label name="ft-points" text="UNSPENT POINTS: 0" class="unspent-label"/>
                <ui:VisualElement name="ft-alloc" class="alloc-list">
                    <ui:VisualElement class="alloc-row"><ui:Label text="MAX HP" class="alloc-name"/><ui:Label name="lbl-MaxHP" text="100" class="alloc-val"/><ui:Button name="alloc-MaxHP" text="+" class="plus-btn"/></ui:VisualElement>
                    <ui:VisualElement class="alloc-row"><ui:Label text="MAX MANA" class="alloc-name"/><ui:Label name="lbl-MaxMana" text="100" class="alloc-val"/><ui:Button name="alloc-MaxMana" text="+" class="plus-btn"/></ui:VisualElement>
                    <ui:VisualElement class="alloc-row"><ui:Label text="ATTACK (AD)" class="alloc-name"/><ui:Label name="lbl-AD" text="10" class="alloc-val"/><ui:Button name="alloc-AD" text="+" class="plus-btn"/></ui:VisualElement>
                    <ui:VisualElement class="alloc-row"><ui:Label text="MAGIC (AP)" class="alloc-name"/><ui:Label name="lbl-AP" text="10" class="alloc-val"/><ui:Button name="alloc-AP" text="+" class="plus-btn"/></ui:VisualElement>
                    <ui:VisualElement class="alloc-row"><ui:Label text="DEFENSE" class="alloc-name"/><ui:Label name="lbl-DEF" text="10" class="alloc-val"/><ui:Button name="alloc-DEF" text="+" class="plus-btn"/></ui:VisualElement>
                    <ui:VisualElement class="alloc-row"><ui:Label text="RESIST" class="alloc-name"/><ui:Label name="lbl-RES" text="10" class="alloc-val"/><ui:Button name="alloc-RES" text="+" class="plus-btn"/></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="popup-actions">
                    <ui:Button name="ft-levelup-apply" text="APPLY" class="bonfire-btn half"/>
                    <ui:Button name="ft-levelup-back" text="BACK" class="bonfire-btn half"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Flasks Popup -->
            <ui:VisualElement name="ft-flasks-menu" class="bonfire-popup hidden">
                <ui:Label text="ALLOCATE FLASKS" class="popup-title"/>
                <ui:VisualElement class="fancy-divider"/>
                <ui:Label name="ft-flasks-total" text="TOTAL FLASKS: 6" class="unspent-label"/>
                <ui:VisualElement class="flask-alloc-container">
                    <ui:VisualElement class="flask-col">
                        <ui:VisualElement class="hud-slot-icon" style="background-color: #ff3b3b; width: 48px; height: 48px; margin: auto; border-radius: 24px;"/>
                        <ui:Label text="HP FLASK" class="flask-name"/>
                        <ui:VisualElement class="flask-stepper">
                            <ui:Button name="flask-hp-sub" text="&lt;" class="stepper-btn"/>
                            <ui:Label name="flask-hp-val" text="3" class="stepper-val"/>
                            <ui:Button name="flask-hp-add" text="&gt;" class="stepper-btn"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="flask-col">
                        <ui:VisualElement class="hud-slot-icon" style="background-color: #3b82ff; width: 48px; height: 48px; margin: auto; border-radius: 24px;"/>
                        <ui:Label text="MANA FLASK" class="flask-name"/>
                        <ui:VisualElement class="flask-stepper">
                            <ui:Button name="flask-mana-sub" text="&lt;" class="stepper-btn"/>
                            <ui:Label name="flask-mana-val" text="3" class="stepper-val"/>
                            <ui:Button name="flask-mana-add" text="&gt;" class="stepper-btn"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="popup-actions">
                    <ui:Button name="ft-flasks-apply" text="APPLY" class="bonfire-btn half"/>
                    <ui:Button name="ft-flasks-back" text="BACK" class="bonfire-btn half"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Fast Travel Popup -->
            <ui:VisualElement name="ft-travel-menu" class="bonfire-popup hidden" style="width: 500px;">
                <ui:Label text="FAST TRAVEL" class="popup-title"/>
                <ui:VisualElement class="fancy-divider"/>
                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center; margin-bottom: 8px;">
                    <ui:Button name="ft-map-prev" text="&lt;" class="stepper-btn"/>
                    <ui:Button name="ft-map-next" text="&gt;" class="stepper-btn"/>
                </ui:VisualElement>
                <ui:VisualElement name="ft-panel" style="background-color: transparent; border-width: 0;">
                    <ui:VisualElement name="ft-list-col">
                        <ui:Label name="ft-count" text="0 / 0 DISCOVERED"/>
                        <ui:ScrollView name="ft-list" style="flex-grow: 1; height: 200px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ft-preview-col">
                        <ui:VisualElement name="ft-preview">
                            <ui:Label name="ft-preview-name" text="SELECT A BEACON"/>
                            <ui:Label name="ft-preview-region" text=""/>
                        </ui:VisualElement>
                        <ui:VisualElement name="ft-actions">
                            <ui:Button name="ft-go" text="TELEPORT" class="ft-btn go"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ft-travel-back" text="BACK" class="bonfire-btn" style="margin-top: 10px;"/>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ==================== GAME OVER ==================== -->
        <ui:VisualElement name="go-screen" class="overlay-screen hidden">
            <ui:VisualElement name="go-dim" class="overlay-screen"/>
            <ui:VisualElement name="go-content">
                <ui:VisualElement name="go-sigil"><ui:Label name="go-sigil-icon" text="☠"/></ui:VisualElement>
                <ui:Label name="go-title" text="YOU DIED"/>
                <ui:Label name="go-subtitle" text="The flame has been extinguished."/>
                <ui:VisualElement name="go-stats">
                    <ui:VisualElement class="go-stat"><ui:Label name="go-time" text="0:00" class="go-stat-val"/><ui:Label text="SURVIVED" class="go-stat-key"/></ui:VisualElement>
                    <ui:VisualElement class="go-stat"><ui:Label name="go-level" text="1" class="go-stat-val"/><ui:Label text="LEVEL" class="go-stat-key"/></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="go-actions">
                    <ui:Button name="go-resume" text="LAST CHECKPOINT" class="go-btn resume"/>
                    <ui:Button name="go-quit" text="QUIT TO MENU" class="go-btn quit"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ==================== LOADING ==================== -->
        <ui:VisualElement name="loading" class="overlay-screen hidden">
            <ui:VisualElement name="loading-content">
                <ui:Label name="loading-title" text="ATTRITION"/>
                <ui:Label name="loading-area" text="LOADING"/>
                <ui:VisualElement name="loading-track"><ui:VisualElement name="loading-fill"/></ui:VisualElement>
                <ui:Label name="loading-status" text="Preparing world..."/>
                <ui:Label name="loading-countdown" text="" class="hidden"/>
                <ui:Label name="loading-tip" text="Hold SPACE to jump higher. Dash grants brief invincibility."/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ==================== PAUSE (ESC) ==================== -->
        <ui:VisualElement name="pause-screen" class="overlay-screen hidden">
            <ui:VisualElement name="pause-dim" class="overlay-screen"/>
            <ui:VisualElement name="pause-content">
                <ui:Label name="pause-title" text="PAUSED"/>
                <ui:VisualElement name="pause-actions">
                    <ui:Button name="pause-resume" text="RESUME" class="pause-btn resume"/>
                    <ui:Button name="pause-settings" text="SETTINGS" class="pause-btn"/>
                    <ui:Button name="pause-quit" text="QUIT TO MENU" class="pause-btn quit"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ==================== SETTINGS (in-game) ==================== -->
        <ui:VisualElement name="settings-screen" class="overlay-screen hidden">
            <ui:VisualElement name="set-dim" class="overlay-screen"/>
            <ui:VisualElement name="set-content">
                <ui:Label name="set-title" text="SETTINGS"/>

                <ui:Label text="AUDIO" class="set-section"/>
                <ui:VisualElement class="set-row">
                    <ui:Label text="Master" class="set-row-key"/>
                    <ui:Slider name="set-vol-master" low-value="0" high-value="1" class="set-slider"/>
                    <ui:Label name="set-vol-master-val" text="80%" class="set-row-val"/>
                </ui:VisualElement>
                <ui:VisualElement class="set-row">
                    <ui:Label text="Music" class="set-row-key"/>
                    <ui:Slider name="set-vol-music" low-value="0" high-value="1" class="set-slider"/>
                    <ui:Label name="set-vol-music-val" text="65%" class="set-row-val"/>
                </ui:VisualElement>
                <ui:VisualElement class="set-row">
                    <ui:Label text="SFX" class="set-row-key"/>
                    <ui:Slider name="set-vol-sfx" low-value="0" high-value="1" class="set-slider"/>
                    <ui:Label name="set-vol-sfx-val" text="100%" class="set-row-val"/>
                </ui:VisualElement>

                <ui:Label text="GAMEPLAY &amp; GRAPHICS" class="set-section"/>
                <ui:VisualElement class="set-row">
                    <ui:Label text="Show Damage Numbers" class="set-row-key wide"/>
                    <ui:Toggle name="set-dmg"/>
                </ui:VisualElement>
                <ui:VisualElement class="set-row">
                    <ui:Label text="Show Other Players" class="set-row-key wide"/>
                    <ui:Toggle name="set-other-players"/>
                </ui:VisualElement>
                <ui:VisualElement class="set-row">
                    <ui:Label text="Show Player Nameplates" class="set-row-key wide"/>
                    <ui:Toggle name="set-player-nameplates"/>
                </ui:VisualElement>
                <ui:VisualElement class="set-row">
                    <ui:Label text="VSync" class="set-row-key wide"/>
                    <ui:Toggle name="set-vsync"/>
                </ui:VisualElement>

                <ui:VisualElement name="set-actions">
                    <ui:Button name="set-reset" text="RESET" class="set-btn"/>
                    <ui:Button name="set-back" text="SAVE &amp; BACK" class="set-btn primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ==================== WAITING FOR PLAYER (coop) ==================== -->
        <ui:VisualElement name="waiting-screen" class="overlay-screen hidden">
            <ui:VisualElement name="waiting-dim"/>
            <ui:VisualElement name="waiting-content">
                <ui:Label text="WAITING FOR PLAYER..." name="waiting-title"/>
                <ui:Label text="Teammate disconnected. The match is paused until they return." name="waiting-desc"/>
                <ui:VisualElement name="waiting-spinner"/>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
