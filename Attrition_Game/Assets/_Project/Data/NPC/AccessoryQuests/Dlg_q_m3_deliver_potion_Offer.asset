  m_Script: {fileID: 11500000, guid: 71a02887f9d289c47b546a0439067775, type: 3}
  m_Name: Dlg_q_m3_deliver_potion_Offer
  m_EditorClassIdentifier: Attrition.Data::Attrition.Data.DialogueSO
  lines:
  - speakerName: Spring Fairy
    text: I have watched this valley rot from its mouth. Carry my account to the
      far end and let them hear it.
  - speakerName: Spring Fairy
    text: Carry my words to the far end of this valley. Do that, and the Alchemist
      Charm is yours.
  - speakerName: Spring Fairy
    text: But a charm like this only binds when two souls walk together. Alone, you
      will earn nothing but the deed.
