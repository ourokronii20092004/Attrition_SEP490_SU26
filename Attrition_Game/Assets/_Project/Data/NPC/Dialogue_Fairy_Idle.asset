  m_Script: {fileID: 11500000, guid: 71a02887f9d289c47b546a0439067775, type: 3}
  m_Name: Dialogue_Fairy_Idle
  m_EditorClassIdentifier: Attrition.Data::Attrition.Data.DialogueSO
  lines:
  - speakerName: Spring Fairy
    text: Ah, a living soul wanders the Ashen Threshold once more.
  - speakerName: Spring Fairy
    text: I am the last warden of this spring. While my light holds, the rot cannot
      cross these stones.
  - speakerName: Spring Fairy
    text: Rest by the water if your bones grow weary, wanderer. The dark beyond is
      patient, and far less kind than I.
