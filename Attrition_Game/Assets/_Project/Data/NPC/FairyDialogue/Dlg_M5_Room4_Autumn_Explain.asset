  m_Script: {fileID: 11500000, guid: 71a02887f9d289c47b546a0439067775, type: 3}
  m_Name: Dlg_M5_Room4_Autumn_Explain
  m_EditorClassIdentifier: Attrition.Data::Attrition.Data.DialogueSO
  lines:
  - speakerName: Autumn Fairy
    text: 'Three fallen guardians wait here: one above, one in this hall, and one
      below.'
  - speakerName: Autumn Fairy
    text: Choose any room first. Its door will seal only while that battle is being
      fought.
  - speakerName: Autumn Fairy
    text: Defeat all three and the sealed door beside me will open the road onward.
