  m_Script: {fileID: 11500000, guid: 71a02887f9d289c47b546a0439067775, type: 3}
  m_Name: Dlg_M5_Ending_Thanks
  m_EditorClassIdentifier: Attrition.Data::Attrition.Data.DialogueSO
  lines:
  - speakerName: Spring Fairy
    text: The corruption is fading. You gave this land another spring.
  - speakerName: Summer Fairy
    text: Your strength carried hope through the darkest road.
  - speakerName: Autumn Fairy
    text: Every sacrifice brought us to this peaceful end.
  - speakerName: Winter Fairy
    text: Thank you. Your journey will be remembered.
