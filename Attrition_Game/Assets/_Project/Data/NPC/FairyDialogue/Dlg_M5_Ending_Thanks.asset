  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 71a02887f9d289c47b546a0439067775, type: 3}
  m_Name: Dlg_M5_Ending_Thanks
  m_EditorClassIdentifier: Attrition.Data::Attrition.Data.DialogueSO
  lines:
  - speakerName: Spring Fairy
    text: The rot is fading. You gave this land its spring back — the first in an
      age.
  - speakerName: Summer Fairy
    text: You crossed every trial and freed every pillar. Your strength carried hope
      through the darkest road.
  - speakerName: Autumn Fairy
    text: You let everything end as it should. Every soul released — that is the
      gift you gave this dead world.
  - speakerName: Winter Fairy
    text: You let them rest instead of staying frozen mid-death. Thank you. Your
      journey will be remembered.
