  m_Name: Dlg_M3_Summer_Idle
  m_EditorClassIdentifier: Attrition.Data::Attrition.Data.DialogueSO
  lines:
  - speakerName: Summer Fairy
    text: The Flame tells a beautiful lie — that rescue is coming. His people sing
      while waiting for what never arrives. Set them free from that false hope.
