  m_Script: {fileID: 11500000, guid: 71a02887f9d289c47b546a0439067775, type: 3}
  m_Name: Dlg_M5_Spring_Idle
  m_EditorClassIdentifier: Attrition.Data::Attrition.Data.DialogueSO
  lines:
  - speakerName: Spring Fairy
    text: The Crown still sits on the throne — the one who raised the seal to keep
      her people from the Void. She is no tyrant. She chose a door with no exit.
  - speakerName: Spring Fairy
    text: Tell her the seal may fall. You are the last child of this world — the
      only one with the right to say it.
