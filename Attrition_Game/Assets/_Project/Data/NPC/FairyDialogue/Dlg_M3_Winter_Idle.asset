  m_Name: Dlg_M3_Winter_Idle
  m_EditorClassIdentifier: Attrition.Data::Attrition.Data.DialogueSO
  lines:
  - speakerName: Winter Fairy
    text: A flask waits below me. Descend from here and search the lower ground.
  - speakerName: Winter Fairy
    text: The other flask is past the path to my right — go up, then cut left along
      the high route.
