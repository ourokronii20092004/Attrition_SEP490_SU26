  m_Script: {fileID: 11500000, guid: 71a02887f9d289c47b546a0439067775, type: 3}
  m_Name: Dlg_M1_Autumn_Idle
  m_EditorClassIdentifier: Attrition.Data::Attrition.Data.DialogueSO
  lines:
  - speakerName: Autumn Fairy
    text: I am autumn — the season of endings. Here, nothing is allowed to end.
      That is the seal's curse.
  - speakerName: Autumn Fairy
    text: Your task is not to kill. It is to let them finish. Remember this when
      you face each pillar.
