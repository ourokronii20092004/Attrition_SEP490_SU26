  m_Script: {fileID: 11500000, guid: 71a02887f9d289c47b546a0439067775, type: 3}
  m_Name: Dialogue_ArchDemon_Intro
  m_EditorClassIdentifier: Attrition.Data::Attrition.Data.DialogueSO
  lines:
  - speakerName: Maren, the Crown
    text: Every road you survived ends here — at the throne of the one who raised
      the seal.
  - speakerName: Maren, the Crown
    text: I am no tyrant, wanderer. I chose to keep my people — when the only other
      door was the Void.
