  m_Script: {fileID: 11500000, guid: 71a02887f9d289c47b546a0439067775, type: 3}
  m_Name: Dialogue_Elf_Death
  m_EditorClassIdentifier: Attrition.Data::Attrition.Data.DialogueSO
  lines:
  - speakerName: Fallen Elf
    text: My lie kept them at peace for an age. But it was never true.
  - speakerName: Fallen Elf
    text: You were right. Better they know the truth — however it hurts — than wait
      for what never comes.
