# =============================================
# Attrition SEP490 - Root .gitignore
#
# Scope: rules that are GLOBAL to the whole repo.
# Project-specific rules live next to their project:
#   Attrition_Game/.gitignore  - Unity
#   Attrition_Web/.gitignore   - .NET + Next.js + secrets
# =============================================

# ---- OS generated files ----
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~

# ---- IDE / Editor ----
.vs/
.vscode/
.idea/
*.suo
*.user
*.userprefs
*.DotSettings.user

# ---- Build & debug noise (any project) ----
*.log
*.pdb
*.tsbuildinfo

# =============================================
# Node.js / Next.js
# =============================================
**/node_modules/
**/.next/
**/out/
next-env.d.ts
.pnp
.pnp.*
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================
# Environment & Secrets (CRITICAL)
# =============================================
.env
.env.local
.env.*.local
*.env.local
*.pem

# =============================================
# Docker
# =============================================
docker-compose.override.yml

# =============================================
# Uploads & Media (user-generated)
# =============================================
uploads/

# =============================================
# Vercel
# =============================================
.vercel

# =============================================
# ParrelSync clones (test coop nhieu acc 1 may)
# =============================================
Attrition_Game_clone_*/
*_clone_*/
.ParrelSyncArguments
