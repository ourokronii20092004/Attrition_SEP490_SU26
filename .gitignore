# =============================================
# Attrition SEP490 - Root .gitignore
#
# Scope: rules that are GLOBAL to the whole repo.
# Project-specific rules live next to their project:
#   Attrition_Game/.gitignore  - Unity
#   Attrition_Web/.gitignore   - .NET + Next.js + secrets
# =============================================

# ---- OS generated files ----
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~

# ---- IDE / Editor ----
.vs/
.vscode/
.idea/
*.suo
*.user
*.userprefs
*.DotSettings.user

# ---- Build & debug noise (any project) ----
*.log
*.pdb
*.tsbuildinfo
__pycache__/
*.py[cod]

# =============================================
# Node.js / Next.js
# =============================================
**/node_modules/
**/.next/
**/out/
next-env.d.ts
.pnp
.pnp.*
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================
# Environment & Secrets (CRITICAL)
# =============================================
.env
.env.local
.env.*.local
*.env.local
*.pem

# =============================================
# Docker
# =============================================
docker-compose.override.yml

# =============================================
# Uploads & Media (user-generated)
# =============================================
uploads/

# =============================================
# Vercel
# =============================================
.vercel

# =============================================
# ParrelSync clones (test coop nhieu acc 1 may)
# =============================================
Attrition_Game_clone_*/
*_clone_*/
.ParrelSyncArguments

# =============================================
# Scratch docs and helper scripts
# =============================================
# Working notes and one-off scripts live at the repo root and are not part of the
# delivered project. Content the app actually serves (the story chapters under
# frontend/src/content) and per-directory READMEs stay tracked.
/*.md
!/README.md
/*.sh
/*.py

# =============================================
# Local UI review scratch (not part of delivery)
# =============================================
.ui-review/
